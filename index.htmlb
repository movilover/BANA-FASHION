</style>
<style id="bfAdmBanner">
/* banners uploaded from the admin panel */
.bnr.bnr-adm{background:#0d0d0d}
.bnr-adm.bnr-click{cursor:pointer}
.bnr-adm .bnr-full{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%;transform:scale(1.07);transition:transform 6.5s ease-out;-webkit-user-drag:none;user-select:none}
.hero-slide.active.bnr-adm .bnr-full{transform:scale(1)}
.bnr-adm .bnr-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.76) 0%,rgba(0,0,0,.42) 48%,rgba(0,0,0,0) 80%);pointer-events:none}
.bnr-adm .bnr-txt{max-width:62%;text-shadow:0 2px 14px rgba(0,0,0,.55)}
.bnr-adm .bnr-h{color:#fff}.bnr-adm .bnr-p{color:#f1f1f1}
.bnr-adm .bnr-btn{background:#fff;color:#0d0d0d;text-shadow:none}
</style>
<style id="bfCardFix">
/* ===== product cards: photo first — tiny corner tags, small heart, brand name as text under the photo, bigger photos ===== */
/* discount tag: small corner tab flush to the photo corner (does not sit on the product) */
html body .pcard .absolute.top-3.left-3,html body .bfx-off{top:0!important;left:0!important;padding:2px 7px 3px!important;border-radius:0 0 10px 0!important;font-size:10px!important;line-height:1.25!important;font-weight:800!important;background:rgba(13,13,13,.78)!important;color:#fff!important;letter-spacing:.01em;box-shadow:none!important;backdrop-filter:none}
/* heart: small, light, tucked in the top-right corner */
html body .pcard .absolute.top-3.right-3,html body .bfx-heart{top:5px!important;right:5px!important;width:24px!important;height:24px!important;min-width:0!important;font-size:11px!important;background:rgba(255,255,255,.55)!important;box-shadow:0 1px 4px rgba(0,0,0,.12)!important;border-radius:50%!important}
html body .pcard .absolute.top-3.right-3:active,html body .bfx-heart:active{background:rgba(255,255,255,.95)!important}
html body .pcard .absolute.top-3.right-3.text-rose-500,html body .bfx-heart.on{background:rgba(255,255,255,.92)!important}
/* image dots: thin, centred at the very bottom */
html body .pcard .pdots,html body .bfx-img .pdots{left:50%!important;right:auto!important;transform:translateX(-50%);bottom:5px!important;gap:3px!important}
html body .pcard .pdot,html body .bfx-img .pdot{width:4px!important;height:4px!important}
html body .bfx-img .pdot.bg-white,html body .pcard .pdot.bg-white{width:11px!important}
/* brand / badge name now lives under the photo as plain text */
.pc-brand{display:block;text-align:center;font-weight:800;font-size:9px;line-height:1.2;letter-spacing:.14em;text-transform:uppercase;color:#b45309;margin:0 0 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bfx-info .pc-brand{font-size:10px;margin-bottom:0}
/* 3-up grid: bigger photos (less gap and frame, taller picture) */
html body #productGrid{gap:5px!important;margin-left:-5px;margin-right:-5px}
@media(min-width:768px){html body #productGrid{gap:14px!important;margin-left:0;margin-right:0}}
html body .pcard{border-radius:14px!important}
html body .pcard>div:first-child{margin:3px 3px 0!important;border-radius:11px!important;aspect-ratio:3/4!important}
html body .pcard>div:last-child{padding:6px 4px 8px!important}
html body .pcard .font-lux{font-size:13.5px!important}
/* 2-up showcase: bigger photos */
#bfFeat{max-width:none;padding:0}
.bfx-grid{gap:7px!important;margin-left:-5px;margin-right:-5px}
@media(min-width:640px){.bfx-grid{gap:16px!important;margin-left:0;margin-right:0}#bfFeat{max-width:760px}}
.bfx-card{border-radius:16px!important}
.bfx-img{margin:4px 4px 0!important;border-radius:12px!important;aspect-ratio:3/4!important}
.bfx-info{padding:8px 8px 10px!important;gap:5px!important}
.bfx-info h3{font-size:13.5px!important;min-height:0!important;margin-bottom:2px}
</style>
<style id="bf-fix2">
/* ===== bug-fix layer 2: stay in the section you opened, no background drift, clear close (X) buttons ===== */
html:has(#successModal:not(.hidden)),html:has(#checkoutModal:not(.hidden)),html:has(#cartDrawer:not(.hidden)),html:has(#wishlistModal:not(.hidden)),html:has(#mobileMenu:not(.hidden)){overflow:hidden!important;overscroll-behavior:none}
#successModal,#checkoutModal,#cartDrawer,#wishlistModal,#mobileMenu{overscroll-behavior:contain}
#successModal{height:100vh;height:100dvh;-webkit-overflow-scrolling:touch}
html,body{overscroll-behavior-x:none}
#shop .rail-sec{overflow-x:clip;overflow-y:visible}
#shop .rail-scroll,.hr-stage{touch-action:pan-y pinch-zoom}
.bf-x{width:44px;height:44px;font-size:18px}
.bf-x i{color:inherit!important;pointer-events:none}
#successModal .pop{position:relative}
#successModal .bf-close{position:absolute;top:12px;right:12px;z-index:3}
html body #successModal .bf-close,html body #cartContent .bf-x,html body #wishlistModal .bf-x,html body #mobileMenu .bf-x{background:#fff!important;border:1.5px solid #0a0a0a!important;color:#0a0a0a!important}
html body #successModal .bf-close:hover,html body #cartContent .bf-x:hover,html body #wishlistModal .bf-x:hover,html body #mobileMenu .bf-x:hover{background:#0a0a0a!important;color:#fff!important}
.bf-x:focus-visible{outline:3px solid #F59E0B;outline-offset:2px}
/* ===== product page: whole product always visible, on every screen ===== */
#productPage{overflow-x:clip;max-width:100%}
#productPage .grid{grid-template-columns:minmax(0,1fr)}
#productPage .grid>*{min-width:0;max-width:100%}
@media(min-width:768px){#productPage .grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
#ppStage{width:100%;max-width:100%;aspect-ratio:4/5;touch-action:pan-y pinch-zoom}
#ppThumbs{max-width:100%;overflow:hidden}
#ppThumbs>div{max-width:100%;-webkit-overflow-scrolling:touch;scrollbar-width:none;overscroll-behavior-x:contain}
#ppThumbs>div::-webkit-scrollbar{display:none}
#ppStage .ppsl>img{object-fit:contain!important;object-position:center}
/* phones: never taller than the screen, so photo + dots + thumbnails fit */
@media(max-width:767px){#ppStage{max-height:calc(100dvh - 190px);margin-inline:auto}}
/* tablets/computers: photo is sized by the window height, never cut off */
@media(min-width:768px){#ppStage{aspect-ratio:auto;height:min(calc(100dvh - 190px),760px);min-height:420px}}
/* ===== slimmer footer ===== */
html body footer>div{padding-top:8px!important;padding-bottom:calc(14px + env(safe-area-inset-bottom,0px))!important}
html body footer .grid{margin-bottom:8px!important}
html body footer .grid>div{padding:14px 16px!important;border-radius:16px!important}
html body footer .grid>div.space-y-4>:not([hidden])~:not([hidden]){margin-top:10px!important}
html body footer .pt-6{padding:9px 14px!important;margin-top:0!important;border-radius:12px!important;justify-content:center!important;text-align:center;font-size:11.5px;line-height:1.4}
</style>


<style id="bana-co-fix">
/* ===== checkout: payment logos + bottom bar polish (visual only) ===== */
html body #checkoutModal .co-pay{gap:12px!important;padding:12px!important;min-height:66px!important;align-items:center!important}
html body #checkoutModal .co-pay .leading-tight{display:block;min-width:0;line-height:1.25}
html body #checkoutModal .co-pay small{white-space:normal}
html body #checkoutModal .co-ico{width:46px;height:46px;border-radius:12px;flex:0 0 46px;display:flex;align-items:center;justify-content:center;overflow:hidden;box-sizing:border-box}
html body #checkoutModal .co-ico-logo{background:#fff!important;border:1px solid #e5e7eb;padding:4px;box-shadow:0 2px 8px -3px rgba(0,0,0,.18)}
html body #checkoutModal .co-ico-logo img{width:100%;height:100%;object-fit:contain;display:block;border-radius:8px;background:#fff}
html body #checkoutModal .co-ico-badge{color:#fff;font-weight:800;font-size:11px;letter-spacing:0;text-align:center;line-height:1.1}
html body #checkoutModal .co-ico-cod{background:#10b981;color:#fff;font-size:18px}
html body #checkoutModal .co-pay.dis{opacity:1!important}
html body #checkoutModal .co-pay.dis .leading-tight{opacity:.55}
html body #checkoutModal .co-pay.dis .co-ico{filter:saturate(.55) opacity(.7)}
html body #checkoutModal .co-pay.dis .co-ico-logo{filter:none;opacity:.85}
/* bottom bar: tidy back button + total + confirm */
html body #checkoutModal .co-mbar{gap:12px!important;align-items:center!important}
html body #checkoutModal .co-mbar .cow-bk{flex:0 0 52px!important;width:52px!important;height:52px!important;min-height:52px!important;padding:0!important;align-items:center!important;justify-content:center!important;border-radius:16px!important;font-size:17px;line-height:1;transition:transform .2s,background .2s}
html body #checkoutModal .co-mbar .cow-bk i{display:block;line-height:1;margin:0}
html body #checkoutModal .co-mbar .cow-bk:active{transform:scale(.94);background:#f3f4f6!important}
html body #checkoutModal .co-mbar .t{flex:0 0 auto;min-width:78px;display:flex;flex-direction:column;justify-content:center;gap:3px}
html body #checkoutModal .co-mbar .t small{font-size:11px;line-height:1}
html body #checkoutModal .co-mbar .t b{font-size:1.2rem;line-height:1.1;white-space:nowrap}
html body #checkoutModal .co-mbar .cow-go{flex:1 1 auto!important;min-width:0}
html body #checkoutModal .co-mbar .cow-go .cow-lb{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
</style>

<style id="bana-co-pay">
html body #checkoutModal .co-pm{display:flex;flex-direction:column;gap:10px;text-align:left}
html body #checkoutModal .co-pm-amt{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;border-radius:14px;background:#0D0D0D;color:#fff}
html body #checkoutModal .co-pm-amt span{font-weight:800;font-size:13px;line-height:1.3}
html body #checkoutModal .co-pm-amt small{display:block;font-weight:600;font-size:11px;color:#d1d5db;margin-top:2px}
html body #checkoutModal .co-pm-amt b{color:#fff;font-size:22px;font-weight:800;white-space:nowrap}
html body #checkoutModal .co-pm-steps>div{display:flex;gap:8px;align-items:flex-start;font-size:12.5px;line-height:1.5;color:#334155}
html body #checkoutModal .co-pm-steps i{flex:0 0 22px;width:22px;height:22px;border-radius:50%;background:#0D0D0D;color:#fff;font-style:normal;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:1px}
html body #checkoutModal .co-pm-num{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-radius:14px;background:#fff;border:1.5px solid #0D0D0D}
html body #checkoutModal .co-pm-num small{display:block;font-size:11px;color:#64748b;font-weight:600}
html body #checkoutModal .co-pm-num b{font-size:20px;letter-spacing:.04em;color:#0D0D0D;font-family:'Plus Jakarta Sans',system-ui,sans-serif}
html body #checkoutModal .co-pm-num button{flex:none;display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border-radius:12px;background:#0D0D0D;color:#fff;font-weight:800;font-size:12px}
html body #checkoutModal .co-pm-note{font-size:11.5px;color:#64748b}
</style>
</body>
</html>

<div id="checkoutModal" class="fixed inset-0 z-[95] hidden overflow-y-auto">
  <div onclick="closeCheckout()" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
  <div class="relative min-h-screen">
    <div class="co-panel w-full max-w-5xl mx-auto min-h-screen shadow-2xl">
      <div class="co-head sticky top-0 z-10 px-4 sm:px-6 py-3.5 flex items-center justify-between flex-wrap">
        <div class="flex items-center gap-3"><span class="co-hic"><i class="fa-solid fa-bag-shopping"></i></span><div><h3 class="font-display font-extrabold text-lg text-white leading-tight">অর্ডার কনফার্ম করুন</h3><p class="text-[11px] text-silver-400">তথ্য দিন, পেমেন্ট বেছে কনফার্ম করুন</p></div></div>
        <span class="co-secure"><i class="fa-solid fa-lock"></i>নিরাপদ চেকআউট</span><button type="button" onclick="closeCheckout()" aria-label="বন্ধ করুন" class="w-9 h-9 rounded-full bg-white/10 hover:bg-gold-500 hover:text-black text-silver-300 transition-colors"><i class="fa-solid fa-xmark"></i></button>
        <div class="cow-stp" id="cowStp">
          <div class="cow-st on" data-i="1"><i>১</i>আপনার তথ্য</div><div class="cow-ln"><i></i></div>
          <div class="cow-st" data-i="2"><i>২</i>ঠিকানা</div><div class="cow-ln"><i></i></div>
          <div class="cow-st" data-i="3"><i>৩</i>পেমেন্ট</div>
        </div>
      </div>
      <form id="checkoutForm" novalidate onsubmit="placeOrder(event)" class="grid md:grid-cols-5 gap-0">
        <div class="md:col-span-3 p-4 sm:p-6 space-y-4">
          <div class="co-box space-y-4"><div class="co-bt"><i class="fa-solid fa-user"></i>আপনার তথ্য</div>
            <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="co-lbl" for="coName">পূর্ণ নাম *</label><div class="co-field"><i class="fa-solid fa-user fi"></i><input id="coName" required autocomplete="name" class="co-in" placeholder="আপনার পূর্ণ নাম লিখুন"></div></div>
          <div><label class="co-lbl" for="coPhone">মোবাইল নম্বর *</label><div class="co-field"><i class="fa-solid fa-phone fi"></i><input id="coPhone" required inputmode="tel" autocomplete="tel" class="co-in" placeholder="01XXXXXXXXX"></div></div>
            </div></div>
          <div class="co-box space-y-4">
            <div class="co-bt"><i class="fa-solid fa-location-dot"></i>ডেলিভারির ঠিকানা</div>
            <div><label class="co-lbl">ডেলিভারি এলাকা *</label>
              <div id="coAreaOpts" role="radiogroup" aria-label="ডেলিভারি এলাকা" class="grid grid-cols-2 gap-2.5">
                <button type="button" id="coAreaIn" role="radio" aria-checked="true" onclick="setArea('dhaka')" class="co-area on"><span class="co-radio"></span><span><b>ঢাকার ভেতরে</b><small id="coAreaInP">Tk 80</small></span></button>
                <button type="button" id="coAreaOut" role="radio" aria-checked="false" onclick="setArea('outside')" class="co-area"><span class="co-radio"></span><span><b>ঢাকার বাইরে</b><small id="coAreaOutP">Tk 150</small></span></button>
              </div></div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div><label class="co-lbl" for="coDist">জেলা *</label><div class="co-field"><i class="fa-solid fa-city fi"></i><select id="coDist" required onchange="onDist()" class="co-in"><option value="">জেলা বাছাই করুন</option></select></div></div>
              <div><label class="co-lbl">বিভাগ</label><div id="coDivTxt" class="co-div"><i class="fa-solid fa-map text-gold-400"></i><span>জেলা বাছলে নিজে থেকে আসবে</span></div><input type="hidden" id="coDiv"></div>
            </div>
            <div id="coUpBox" class="hidden"><label class="co-lbl" for="coUp">উপজেলা / থানা *</label><div class="co-field"><i class="fa-solid fa-map-pin fi"></i><select id="coUp" class="co-in"><option value="">উপজেলা / থানা বাছাই করুন</option></select></div></div>
            <div id="coDelTag" class="co-tag"></div>
          <input type="hidden" id="coArea" value="dhaka">
          <div><label class="co-lbl" for="coAddress">পূর্ণ ঠিকানা *</label><div class="co-field ta"><i class="fa-solid fa-house fi"></i><textarea id="coAddress" required rows="3" class="co-in" placeholder="বাড়ি নং, রোড, গ্রাম / এলাকা"></textarea></div></div>
          <div class="rounded-2xl p-4 bg-gradient-to-br from-ink-900 to-ink-800 text-white border border-gold-500/30 flex items-center gap-3 shadow-lg">
            <div class="w-12 h-12 rounded-xl btn-gold flex items-center justify-center text-lg shrink-0"><i class="fa-solid fa-location-crosshairs"></i></div>
            <div class="flex-1 min-w-0"><div class="font-extrabold text-sm">আমার বর্তমান লোকেশন ব্যবহার করুন</div><div id="geoMsg" class="text-[11px] text-silver-400 leading-snug">GPS দিয়ে জেলা, এলাকা ও ঠিকানা নিজে থেকে পূরণ হবে</div></div>
            <button type="button" id="geoBtn" onclick="useMyLocation()" class="px-4 py-2.5 rounded-xl btn-gold text-xs font-extrabold shrink-0"><i class="fa-solid fa-satellite-dish mr-1"></i>লোকেট</button>
          </div><input type="hidden" id="coLat"><input type="hidden" id="coLng">
          <div><label class="co-lbl" for="coNote">অর্ডার নোট (ঐচ্ছিক)</label><div class="co-field"><i class="fa-solid fa-pen-to-square fi"></i><input id="coNote" class="co-in" placeholder="বিশেষ কোনো নির্দেশনা"></div></div>
          </div>
          <div id="coPayBox" class="co-box space-y-3">
            <div class="co-bt"><i class="fa-solid fa-wallet"></i>পেমেন্ট মেথড *</div>
            <label id="coDelChkWrap" class="co-delchk"><input type="checkbox" id="coDelChk" onchange="onDelChk()"><span id="coDelChkTxt">ডেলিভারি চার্জ অনলাইনে পরিশোধ করেছি<small>বিকাশ/নগদে পাঠিয়ে নিচে ট্রানজেকশন আইডি (TrxID) দিন</small></span></label>
            <div id="coPayOpts" role="radiogroup" aria-label="পেমেন্ট মেথড" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5"></div>
            <div id="coPayInfo" class="hidden co-payinfo space-y-2.5">
              <div id="coPayMsg"></div>
              <div class="co-field"><i class="fa-solid fa-mobile-screen-button fi"></i><input id="coSender" inputmode="tel" class="co-in" placeholder="আপনার সেন্ডার নম্বর (01XXXXXXXXX)"></div>
              <div class="co-field"><i class="fa-solid fa-hashtag fi"></i><input id="coTrx" class="co-in uc" placeholder="Transaction ID (TrxID)" oninput="chkTrx()"></div>
              <div id="coTrxErr" class="text-[11px] font-extrabold text-red-400"></div>
              <div class="text-[11px] text-silver-400">আপনার পেমেন্ট আমরা পরে যাচাই করে নেব, এখন অর্ডার সাথে সাথে কনফার্ম হবে।</div>
            </div>
          </div>
          <div class="co-tag"><i class="fa-solid fa-truck-fast text-gold-400 text-lg"></i><div class="leading-relaxed"><b>ডেলিভারি চার্জ</b><div class="mt-0.5">ঢাকার ভিতরে: <span id="noteIn" class="text-gold-400 font-bold"></span> &nbsp;|&nbsp; ঢাকার বাইরে: <span id="noteOut" class="text-gold-400 font-bold"></span></div><div id="noteFree" class="text-silver-400 mt-0.5"></div></div></div>
        </div>
        <div class="md:col-span-2 p-4 sm:p-6 co-aside border-t border-white/10 md:border-t-0 md:border-l flex flex-col">
          <h4 class="co-bt mb-3"><i class="fa-solid fa-receipt"></i>অর্ডার সামারি<span id="coCnt" class="ml-auto text-[11px] font-bold text-silver-400"></span></h4>
          <div id="coItems" class="space-y-2.5 flex-1 max-h-[24rem] overflow-y-auto text-xs"></div>
          <div class="mt-4"><div class="flex gap-2"><div class="co-field flex-1 min-w-0"><i class="fa-solid fa-ticket fi"></i><input id="coPromo" onkeydown="if(event.key==='Enter'){event.preventDefault();applyPromo();}" class="co-in uc tracking-wider" style="padding-top:10px;padding-bottom:10px;font-size:13px" placeholder="প্রোমো কোড"></div><button type="button" onclick="applyPromo()" class="px-4 rounded-xl border border-gold-500/60 text-gold-400 hover:bg-gold-500 hover:text-black text-xs font-extrabold whitespace-nowrap transition-colors">প্রয়োগ করুন</button></div><div id="promoMsg" class="text-[11px] mt-1 font-bold"></div></div>
          <div class="mt-4 pt-3 border-t border-white/10 space-y-2 text-[13px]">
            <div class="co-row"><span class="text-silver-400">সাবটোটাল</span><span id="coSub" class="font-bold text-white"></span></div>
            <div class="co-row"><span id="coShipLbl" class="text-silver-400">ডেলিভারি</span><span id="coShip" class="font-bold text-white"></span></div>
            <div id="coDiscRow" class="hidden"><div class="co-row"><span class="text-emerald-400 font-bold"><i class="fa-solid fa-tag mr-1"></i><span id="coDiscCode">প্রোমো</span></span><span id="coDisc" class="font-bold text-emerald-400"></span></div></div>
            <div class="co-row text-base font-extrabold pt-2.5 border-t border-white/10"><span class="text-white">মোট</span><span id="coTotal" class="font-display text-xl text-gold-400"></span></div>
          </div>
          <button id="coSubmit" type="submit" class="co-submit btn-gold mt-4"><i class="fa-solid fa-lock mr-2"></i>অর্ডার কনফার্ম করুন</button>
          <p class="text-[10.5px] text-silver-400 text-center mt-2.5"><i class="fa-solid fa-shield-halved text-gold-500 mr-1"></i>আপনার তথ্য সুরক্ষিত · ক্যাশ অন ডেলিভারি সুবিধা আছে</p>
          <div class="co-trust"><span><i class="fa-solid fa-truck-fast"></i>দ্রুত ডেলিভারি</span><span><i class="fa-solid fa-hand-holding-dollar"></i>ক্যাশ অন ডেলিভারি</span><span><i class="fa-solid fa-rotate-left"></i>সহজ এক্সচেঞ্জ</span></div>
        </div>
      </form>
      <div class="co-mbar"><button type="button" id="cowBack" class="cow-bk" aria-label="পেছনে" style="display:none"><i class="fa-solid fa-arrow-left"></i></button><div class="t"><small>মোট</small><b id="coMTotal"></b></div><button type="button" id="cowNext" class="cow-go"><span class="cow-lb"><i class="fa-solid fa-arrow-right mr-2"></i>পরবর্তী ধাপ</span></button></div>
      <script>(function(){var t=document.getElementById('coTotal'),m=document.getElementById('coMTotal');if(!t||!m)return;function f(){m.textContent=t.textContent}f();new MutationObserver(f).observe(t,{childList:true,characterData:true,subtree:true});})();</script>
    </div>
  </div>
</div>

<!-- SUCCESS MODAL (full-page order confirmation) -->

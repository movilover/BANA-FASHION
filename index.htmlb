 {bg:'linear-gradient(120deg,#021a12 0%,#064e3b 55%,#0f766e 100%)',icon:'fa-tags',tag:'কম্বো অফার',big:'২টি কিনলে ১০% সাশ্রয়',title:'পছন্দমতো মিলিয়ে নিন',text:'যেকোনো দুইটি পণ্য নিন, অর্ডারে আরও সাশ্রয় করুন।',cta:'অফারটি নিন',cat:'all'},
 {bg:'linear-gradient(120deg,#12061f 0%,#3b1275 55%,#6d28d9 100%)',icon:'fa-truck-fast',tag:'ফ্রি ডেলিভারি',big:'৩,০০০ টাকার বেশি অর্ডারে',title:'সারা বাংলাদেশে ফ্রি ডেলিভারি',text:'ক্যাশ অন ডেলিভারি · পণ্য দেখে টাকা দিন।',cta:'এখনই অর্ডার করুন',cat:'all'},
 {bg:'linear-gradient(120deg,#1c0509 0%,#5f1212 55%,#b91c1c 100%)',icon:'fa-shirt',tag:'টি-শার্ট ডিল',big:'মাত্র ৫৯০ টাকা থেকে',title:'হেভি কটন টি-শার্ট ও পোলো',text:'সেরা দামে প্রতিদিনের আরাম।',cta:'টি-শার্ট দেখুন',cat:'tshirts'},
 {bg:'linear-gradient(120deg,#050505 0%,#1a1204 50%,#7c5a0a 100%)',icon:'fa-bolt',tag:'নতুন কালেকশন',big:'একদম নতুন',title:'প্রতি সপ্তাহে নতুন স্টাইল',text:'সর্বশেষ BANA FASHION লুক সবার আগে পরুন।',cta:'নতুন দেখুন',cat:'all'}
];

<script>
/* taps made before the main script finishes loading are queued and replayed (nothing is lost) */
(function(){
  window.__q=[];
  'loadMore,ppGo,ppSize,ppColor,ppQty,ppAdd,ppHeart,ppRate,ppToggleForm,ppSubmitReview,showMini,hideMini,toggleHelp,toggleMobileMenu,nextHeroSlide,prevHeroSlide,goToHeroSlide,filterCategory,goShop,handleSearch,setSort,resetFilters,openProduct,closeProduct,addToCart,cartQty,removeItem,toggleCartDrawer,toggleWishlist,toggleWishlistModal,openAccount,closeAuth,setAuthTab,submitAuth,googleSignIn,doSignOut,startCheckout,closeCheckout,setPayM,onDist,applyPromo,useMyLocation,showLastInv,showMyInv,showInvoice,openTrack,closeTrack,doTrack,copyNum,chkTrx,updateCheckoutTotals,placeOrder,setArea,coQty,coRemove,closeConfirm,closeValPop,ppDescToggle,ppRvMore,openMyOrders,closeMyOrders,myoInv,myoFromConfirm,railOpen,railClose,railPick,railSide,railSize,railQty,railBuy,railAdd'.split(',').forEach(function(n){ if(!window[n]) window[n]=function(){ window.__q.push([n,[].slice.call(arguments)]); }; });
  /* splash overlay must never swallow taps while it fades out */
  function free(){ var p=document.getElementById('preloader'); if(p) p.style.pointerEvents='none'; }
  if((window.__splash||0)>=1) free(); else document.addEventListener('splash:exit',free,{once:true});
  /* product-section lighting: on while the section top is on screen, off when scrolled away, on again when back */
  var fx=document.getElementById('shopFx'), sw=document.getElementById('fxSwitch'), stg=document.getElementById('fxStage');
  if(fx){
    /* timeline: person rises -> waves bye-bye -> presses the switch -> lamp on -> spotlight sweeps the products -> all off */
    var SWEEP=2200, RISE=1700, BYE=1400, T=[], busy=false, raf=0;
    var dim=stg&&stg.querySelector('.fx-dim'), beam=stg&&stg.querySelector('.fx-beam'), lens=fx.querySelector('.fx-lens');
    var reduce=!!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);
    var later=function(f,ms){ T.push(setTimeout(f,ms)); };
    var label=function(on){ if(sw){ sw.setAttribute('aria-pressed',on?'true':'false'); sw.setAttribute('aria-label',on?'লাইট নিভান':'লাইট জ্বালান'); } };
    var stopAll=function(){ T.forEach(clearTimeout); T=[]; cancelAnimationFrame(raf); if(stg) stg.classList.remove('on'); busy=false; };
    var sweep=function(){
      if(!dim||!beam) return;
      var t0=performance.now(), W=innerWidth, H=innerHeight, R=Math.max(150,Math.min(300,W*.34));
      var P0=[W*.20,H*.28], P1=[W*.80,H*.47], P2=[W*.22,H*.74];            /* corner -> corner -> corner */
      var C=[2*P1[0]-(P0[0]+P2[0])/2, 2*P1[1]-(P0[1]+P2[1])/2];
      var frame=function(now){
        var k=Math.min(1,(now-t0)/SWEEP), u=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2, a=(1-u)*(1-u), b=2*(1-u)*u, c=u*u;
        var x=a*P0[0]+b*C[0]+c*P2[0], y=a*P0[1]+b*C[1]+c*P2[1];
        dim.style.background='radial-gradient(circle at '+x.toFixed(1)+'px '+y.toFixed(1)+'px,rgba(255,228,150,.30) 0,rgba(255,228,150,.11) '+(R*.6).toFixed(0)+'px,rgba(6,6,10,.56) '+(R*1.18).toFixed(0)+'px)';
        var r=lens?lens.getBoundingClientRect():fx.getBoundingClientRect(), lx=r.left+r.width/2, ly=r.top+r.height/2;
        var dx=x-lx, dy=y-ly, len=Math.sqrt(dx*dx+dy*dy), ang=Math.atan2(dy,dx)*180/Math.PI;
        beam.style.width=len.toFixed(0)+'px'; beam.style.height=(R*1.5).toFixed(0)+'px';
        beam.style.transform='translate('+lx.toFixed(1)+'px,'+ly.toFixed(1)+'px) rotate('+ang.toFixed(2)+'deg) translateY(-50%)';
        if(k<1) raf=requestAnimationFrame(frame);
      };
      frame(t0);
    };
    var lightUp=function(t){
      later(function(){ fx.classList.remove('bye'); fx.classList.add('press'); },t);                 /* hand reaches the switch */
      later(function(){ fx.classList.add('on'); label(true); },t+380);                               /* switch flips, lamp turns on */
      later(function(){ if(stg&&!reduce){ stg.classList.add('on'); sweep(); } },t+520);               /* spotlight sweeps products */
      later(function(){ fx.classList.remove('press'); },t+950);                                      /* hand goes back */
      later(function(){ if(stg) stg.classList.remove('on'); fx.classList.remove('on'); fx.classList.add('fade'); label(false); },t+520+SWEEP+100);
      later(function(){ fx.classList.remove('fade'); cancelAnimationFrame(raf); busy=false; },t+520+SWEEP+900);
    };
    var begin=function(){ stopAll(); busy=true; later(function(){ fx.classList.add('bye'); },RISE); lightUp(RISE+BYE); };
    var off=function(){ stopAll(); fx.classList.remove('show','on','bye','press','fade'); label(false); };
    var start=function(){ if(fx.classList.contains('show')) return; fx.classList.add('show'); begin(); };
    if(sw) sw.addEventListener('click',function(){ if(busy) return; fx.classList.add('show'); busy=true; lightUp(0); });
    if(!('IntersectionObserver' in window)) start();
    else new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting&&e.intersectionRatio>=.3) start(); else if(!e.isIntersecting) off(); }); },{threshold:[0,.3,.6]}).observe(fx);
  }
})();
</script>
<script type="module">
/* ================= FIREBASE (v10 Web SDK) ================= */
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { getFirestore, collection, getDocs, addDoc, serverTimestamp, doc, getDoc, setDoc, increment, query, where, writeBatch, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
import { getAuth, onAuthStateChanged, signInWithPopup, GoogleAuthProvider, createUserWithEmailAndPassword, signInWithEmailAndPassword, updateProfile, signOut, signInAnonymously } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
let initializeAppCheck, ReCaptchaV3Provider, getAppCheckToken;   /* loaded lazily below, only when APPCHECK_SITE_KEY is set */

/* >>> Replace the YOUR_... values with the keys from Firebase Console > Project Settings > Your apps (Web) <<< */
const firebaseConfig = {
  apiKey: "AIzaSyBwMWJ-OMMVR-aeiP9mrwGCqpGzxuranFI",
  authDomain: "bana-fashion.firebaseapp.com",
  projectId: "bana-fashion",
  storageBucket: "bana-fashion.firebasestorage.app",
  messagingSenderId: "143663802409",
  appId: "1:143663802409:web:fe1ceb33a3dfa33fe0d438"
};
/* ===== (ঐচ্ছিক) Firebase App Check — reCAPTCHA v3 SITE KEY এখানে বসান; ফাঁকা রাখলে বন্ধ থাকবে ===== */
const APPCHECK_SITE_KEY = "";
const FIREBASE_READY = !String(firebaseConfig.apiKey).startsWith("YOUR_");
let db = null, auth = null;
if (FIREBASE_READY) {
  const app = initializeApp(firebaseConfig);
  if (APPCHECK_SITE_KEY) { try { const _ac = await import("https://www.gstatic.com/firebasejs/10.8.0/firebase-app-check.js"); initializeAppCheck=_ac.initializeAppCheck; ReCaptchaV3Provider=_ac.ReCaptchaV3Provider; getAppCheckToken=_ac.getToken; window.__appCheck = initializeAppCheck(app, { provider: new ReCaptchaV3Provider(APPCHECK_SITE_KEY), isTokenAutoRefreshEnabled: true }); window.__getAppCheckToken = getAppCheckToken; } catch (e) { console.warn('AppCheck:', e); } }
  db = getFirestore(app);
  auth = getAuth(app);
}

/* ===== ADMIN-LINKED: visit tracking, signup counter ===== */
const dk=()=>new Date().toLocaleDateString('en-CA');
async function bump(f){ if(!FIREBASE_READY) return; try{ await setDoc(doc(db,'stats',dk()),{[f]:increment(1)},{merge:true}); await setDoc(doc(db,'stats','total'),{[f]:increment(1)},{merge:true}); }catch(e){} }
(async()=>{ if(!FIREBASE_READY) return; try{ if(sessionStorage.getItem('bf_v')) return; await new Promise(r=>setTimeout(r,0)); await Promise.race([authReady,new Promise(r=>setTimeout(r,6000))]); sessionStorage.setItem('bf_v','1');
  const d=dk(), first=localStorage.getItem('bf_vd')!==d, neu=!localStorage.getItem('bf_seen'); localStorage.setItem('bf_vd',d); localStorage.setItem('bf_seen','1');
  await setDoc(doc(db,'stats',d),{views:increment(1),...(first?{visitors:increment(1)}:{})},{merge:true});
  await setDoc(doc(db,'stats','total'),{views:increment(1),...(neu?{visitors:increment(1)}:{})},{merge:true});
  let ref='Direct'; try{ if(document.referrer) ref=new URL(document.referrer).hostname; }catch(e){}
  await addDoc(collection(db,'visits'),{d,t:serverTimestamp(),dev:/Mobi|Android/i.test(navigator.userAgent)?'Mobile':'Desktop',ref,new:neu}); }catch(e){} })();
async function ensureUser(u){ try{ const r=doc(db,'users',u.uid); if(!(await getDoc(r)).exists()){ await setDoc(r,{name:u.displayName||'',email:u.email||'',createdAt:serverTimestamp()}); bump('signups'); } }catch(e){} }
/* ================= DATA ================= */
const CATEGORIES = [ {id:'all',label:'সব পণ্য'} ];   /* only "all" is built in; every other category comes from the admin panel (Firestore 'categories') */
const CATBN={all:'সব পণ্য',shoes:'জুতা',shirts:'শার্ট',tshirts:'টি-শার্ট ও পোলো',jeans:'ডেনিম জিন্স',pants:'প্যান্ট',shorts:'কোয়ার্টার শর্টস',jackets:'জ্যাকেট ও হুডি',threepiece:'থ্রি পিস',watches:'ঘড়ি'};
CATEGORIES.forEach(c=>{ if(CATBN[c.id]) c.label=CATBN[c.id]; });
/* label of a category: accepts an id string OR a Firestore category object (this used to return the object itself -> "[object Object]") */
const _s=v=>typeof v==='string'?v.trim():(typeof v==='number'?String(v):(v&&typeof v==='object'?_s(v.bn||v.bangla||v.en||v.name||v.label||''):''));
const _url=u=>typeof u==='string'?u:(u&&typeof u==='object'?_s(u.url||u.src||u.image||u.href):'');
/* Cloudinary responsive delivery: DB urls carry f_auto,q_auto (full-HD original). Cap the width per use so phones never download the big file for a small card; c_limit never upscales. */
const CLX=(u,w)=>(typeof u==='string'&&w&&u.indexOf('res.cloudinary.com/')>0)?u.replace('/upload/f_auto,q_auto/','/upload/f_auto,q_auto,c_limit,w_'+w+'/'):u;
const _list=(a,f)=>(Array.isArray(a)?a:(a==null||a===''?[]:[a])).map(f).filter(Boolean);
/* Firestore sometimes stores text/lists as objects -> coerce every displayed product field to plain strings once, at load time */
function normProduct(p){ const o={...p};
  ['title','description','badge','brand','color','material'].forEach(k=>{ if(o[k]&&typeof o[k]==='object') o[k]=_s(o[k]); });
  if(o.category&&typeof o.category==='object') o.category=_s(o.category.id||o.category.slug||o.category.value||o.category.name||o.category.label);
  if(o.sizes) o.sizes=_list(o.sizes,x=>typeof x==='string'?x:_s(x));
  if(o.colors) o.colors=_list(o.colors,x=>typeof x==='string'?x:_s(x));
  if(o.images) o.images=_list(o.images,_url);
  if(Array.isArray(o.imgColors)) o.imgColors=o.imgColors.map(x=>_s(x)); else delete o.imgColors;   /* colour tag of every photo (same order as images) */
  if(o.image&&typeof o.image==='object') o.image=_url(o.image);
  ['price','oldPrice','rating','reviews'].forEach(k=>{ if(o[k]&&typeof o[k]==='object') o[k]=Number(o[k].value??o[k].amount)||null; });
  return o; }
const catLabel=c=>{ if(c&&typeof c==='object'){ const id=_s(c.id); return _s(c.nameBn||c.name_bn||c.bn||c.labelBn)||_s(c.label)||_s(c.name)||_s(c.title)||CATBN[id]||id; } return CATBN[c]||_s(c); };
const BADGEBN={new:'নতুন',hot:'হট',trending:'ট্রেন্ডিং',popular:'জনপ্রিয়',premium:'প্রিমিয়াম',limited:'লিমিটেড',bestseller:'বেস্টসেলার',set:'সেট',essential:'এসেনশিয়াল',value:'ভ্যালু',sale:'সেল',eid:'ঈদ'};
const badgeBn=b=>BADGEBN[String(b||'').toLowerCase()]||b;
const bnum=n=>String(n).replace(/\d/g,d=>'০১২৩৪৫৬৭৮৯'[d]);
const DBN={Dhaka:'ঢাকা',Gazipur:'গাজীপুর',Narayanganj:'নারায়ণগঞ্জ',Narsingdi:'নরসিংদী',Manikganj:'মানিকগঞ্জ',Munshiganj:'মুন্সিগঞ্জ',Faridpur:'ফরিদপুর',Gopalganj:'গোপালগঞ্জ',Madaripur:'মাদারীপুর',Rajbari:'রাজবাড়ী',Shariatpur:'শরীয়তপুর',Tangail:'টাঙ্গাইল',Kishoreganj:'কিশোরগঞ্জ',Chattogram:'চট্টগ্রাম',"Cox's Bazar":'কক্সবাজার',Cumilla:'কুমিল্লা',Feni:'ফেনী',Brahmanbaria:'ব্রাহ্মণবাড়িয়া',Noakhali:'নোয়াখালী',Lakshmipur:'লক্ষ্মীপুর',Chandpur:'চাঁদপুর',Khagrachhari:'খাগড়াছড়ি',Rangamati:'রাঙ্গামাটি',Bandarban:'বান্দরবান',Rajshahi:'রাজশাহী',Chapainawabganj:'চাঁপাইনবাবগঞ্জ',Naogaon:'নওগাঁ',Natore:'নাটোর',Pabna:'পাবনা',Sirajganj:'সিরাজগঞ্জ',Bogura:'বগুড়া',Joypurhat:'জয়পুরহাট',Khulna:'খুলনা',Bagerhat:'বাগেরহাট',Satkhira:'সাতক্ষীরা',Jashore:'যশোর',Jhenaidah:'ঝিনাইদহ',Magura:'মাগুরা',Narail:'নড়াইল',Kushtia:'কুষ্টিয়া',Chuadanga:'চুয়াডাঙ্গা',Meherpur:'মেহেরপুর',Barishal:'বরিশাল',Bhola:'ভোলা',Jhalokati:'ঝালকাঠি',Patuakhali:'পটুয়াখালী',Pirojpur:'পিরোজপুর',Barguna:'বরগুনা',Sylhet:'সিলেট',Moulvibazar:'মৌলভীবাজার',Habiganj:'হবিগঞ্জ',Sunamganj:'সুনামগঞ্জ',Rangpur:'রংপুর',Dinajpur:'দিনাজপুর',Kurigram:'কুড়িগ্রাম',Lalmonirhat:'লালমনিরহাট',Nilphamari:'নীলফামারী',Gaibandha:'গাইবান্ধা',Thakurgaon:'ঠাকুরগাঁও',Panchagarh:'পঞ্চগড়',Mymensingh:'ময়মনসিংহ',Jamalpur:'জামালপুর',Netrokona:'নেত্রকোনা',Sherpur:'শেরপুর'};
const DVBN={Dhaka:'ঢাকা',Chattogram:'চট্টগ্রাম',Rajshahi:'রাজশাহী',Khulna:'খুলনা',Barishal:'বরিশাল',Sylhet:'সিলেট',Rangpur:'রংপুর',Mymensingh:'ময়মনসিংহ'};

/* No dummy/fallback products: data is loaded only from Firebase */
const SIZES = ['M','L','XL','XXL'];
let FREE_SHIP = 3000;
const SHIP = {dhaka:80,outside:150};
/* payment brand colours + labels (was missing -> ReferenceError inside renderPay() -> checkout never opened) */
const PCOL={bkash:['#E2136E','bKash'],nagad:['#F6921E','Nagad'],rocket:['#8C3494','Rocket'],upay:['#EAB308','Upay']};

const state = { products:[],loaded:false,rvUnsub:null, cart:[], wishlist:[], cat:'all', q:'', sort:'default', hero:0, user:null, pm:{id:null,size:'M',qty:1}, pendingCheckout:false, authTab:'login', buyNow:null, hold:false };
const $ = id => document.getElementById(id);
const money = n => 'Tk ' + Number(n||0).toLocaleString('en-US',{minimumFractionDigits:(Number(n)%1?2:0),maximumFractionDigits:2});
const esc = s => String((s&&typeof s==='object'&&!Array.isArray(s))?(s.bn||s.label||s.name||s.title||''):(s ?? '')).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const save = (k,v) => { try{localStorage.setItem(k,JSON.stringify(v))}catch(e){} };
const load = (k,d) => { try{const v=JSON.parse(localStorage.getItem(k)); return v ?? d}catch(e){return d} };
/* show the admin's categories instantly from the last visit (the live list from the admin panel replaces them as soon as it loads) */
try{ const _cc=load('bana_cats_v1',[]); if(Array.isArray(_cc)&&_cc.length) CATEGORIES.push(..._cc.filter(c=>c&&c.id&&c.id!=='all').map(c=>({id:c.id,label:c.label||CATBN[c.id]||String(c.id)}))); }catch(e){}

/* ================= TOAST ================= */
function toast(msg, ok=true){
  const el=document.createElement('div');
  el.className='animate-toast bg-ink-900 text-white px-4 py-3 rounded-2xl shadow-2xl text-xs font-bold flex items-center gap-2 pointer-events-auto border border-white/10';
  el.innerHTML=`<i class="fa-solid ${ok?'fa-circle-check text-emerald-400':'fa-circle-exclamation text-amber-400'}"></i><span>${esc(msg)}</span>`;
  $('toastContainer').appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transform='translateY(100%)';el.style.transition='all .3s';setTimeout(()=>el.remove(),300)},2800);
}

/* ================= HERO SLIDER ================= */
let heroTimer;
const HERO_DEFAULT=3500;                /* banner 1 = 3.8s (greeting), banner 2 = 8.5s (brand name) via data-dur; every other banner 3.5s */
let catsInView=false, catSeqT, spotT;   /* category sequence state */
function restartHero(){ const sl=document.querySelectorAll('.hero-slide'); if(!sl.length) return; sl.forEach(x=>x.classList.remove('active')); void document.body.offsetWidth; showHero(0); }
function heroCounters(sl){
  sl.querySelectorAll('[data-hc]').forEach(el=>{
    cancelAnimationFrame(el._r);
    const to=+el.dataset.hc, dec=+(el.dataset.dec||0), del=+(el.dataset.delay||0), dur=+(el.dataset.cdur||2200), on=sl.classList.contains('active');
    if(!on){ if(!sl.classList.contains('leaving')) el.textContent=(0).toFixed(dec); return; }
    el.textContent=(0).toFixed(dec); const t0=performance.now()+del;
    const f=t=>{ const p=Math.min(1,Math.max(0,(t-t0)/dur)), e=1-Math.pow(1-p,3); el.textContent=(to*e).toFixed(dec); if(p<1) el._r=requestAnimationFrame(f); };
    el._r=requestAnimationFrame(f);
  });
}
function showHero(i){
  const slides=document.querySelectorAll('.hero-slide'), bars=document.querySelectorAll('.hero-bar');
  state.hero=(i+slides.length)%slides.length;
  { const prev=document.querySelector('.hero-slide.active'); slides.forEach((s,idx)=>{ const on=idx===state.hero; s.classList.toggle('leaving',!on&&s===prev); s.classList.toggle('active',on); }); }
  bars.forEach((b,idx)=>{ b.classList.remove('run'); b.style.width = idx<state.hero?'100%':'0'; if(idx===state.hero){ void b.offsetWidth; b.style.width=''; b.classList.add('run'); } });
  let dur=+(slides[state.hero].dataset.dur)||HERO_DEFAULT; const ab=bars[state.hero]; if(ab) ab.style.animationDuration=dur+'ms';
  slides.forEach(heroCounters);
  clearTimeout(heroTimer); if(slides.length>1) heroTimer=setTimeout(()=>showHero(state.hero+1),dur);   /* last banner (shop) stays permanently */
}
const nextHeroSlide=()=>showHero(state.hero+1), prevHeroSlide=()=>showHero(state.hero-1), goToHeroSlide=i=>showHero(i);

/* ================= PRODUCTS ================= */
const PG_ICON={all:'fa-border-all',shoes:'fa-shoe-prints',shirts:'fa-shirt',tshirts:'fa-shirt',jeans:'fa-user-tie',pants:'fa-user-tie',shorts:'fa-person-walking',jackets:'fa-vest',threepiece:'fa-vest',watches:'fa-clock'};
let _pgSig='',_pgFirst=true;
function pgCount(id){ try{ const b=state.products.filter(p=>!p._rail); return id==='all'?b.length:b.filter(p=>inCategory(p,id)).length; }catch(e){ return 0; } }
function pgPill(instant){ const rail=$('filterTabs'); if(!rail) return; const a=rail.querySelector('.pg-chip.on'), pill=rail.querySelector('.pg-pill'); if(!a||!pill||!a.offsetWidth) return;
  if(instant) pill.style.transition='none';
  pill.style.width=a.offsetWidth+'px'; pill.style.height=a.offsetHeight+'px'; pill.style.transform='translate('+a.offsetLeft+'px,'+a.offsetTop+'px)';
  if(instant){ pill.offsetWidth; pill.style.transition=''; }
  if(rail.scrollWidth>rail.clientWidth+4){ const x=a.offsetLeft-(rail.clientWidth-a.offsetWidth)/2; rail.scrollTo({left:Math.max(0,x),behavior:instant?'auto':'smooth'}); } }
function renderTabs(){
  const rail=$('filterTabs'); if(!rail) return;
  const sig=CATEGORIES.map(c=>c.id+'|'+c.label+'|'+pgCount(c.id)).join(',');
  if(sig!==_pgSig){ _pgSig=sig; const enter=_pgFirst; _pgFirst=false;
    rail.innerHTML='<span class="pg-pill"></span>'+CATEGORIES.map((c,i)=>`<button type="button" data-c="${esc(c.id)}" style="--i:${i}" class="pg-chip${enter?' pg-enter':''}"><i class="fa-solid ${PG_ICON[c.id]||'fa-tag'}"></i>${esc(c.label)}<small>${bnum(pgCount(c.id))}</small></button>`).join('');
  }
  rail.querySelectorAll('.pg-chip').forEach(b=>b.classList.toggle('on',b.dataset.c===state.cat));
  requestAnimationFrame(()=>pgPill(false)); setTimeout(()=>pgPill(true),80);
}
function pgSwap(fn){ const g=$('productGrid'); g.classList.add('pg-out'); setTimeout(()=>{ fn(); g.classList.remove('pg-out'); },210); }
const _ordT=p=>{ const c=p&&p.createdAt; if(!c) return 0; if(c.toMillis) return c.toMillis(); if(c.seconds) return c.seconds*1000; const x=typeof c==='string'?Date.parse(c):+c; return x||0; };
function _ordCmp(a,b){ const NOW=_ordCmp.n||(_ordCmp.n=Date.now()); const k=p=>(p.order!=null&&p.order!==''&&!isNaN(+p.order))?+p.order:-(_ordT(p)||NOW); return k(a)-k(b); }
function _num(v){ const n=parseFloat(String(v==null?'':v).replace(/[^\d.\-]/g,'')); return isNaN(n)?0:n; }
function _pageSize(){ return 10; }   /* home shows 10 products in a row, no 'load more' */
function resetLimit(){ const home=state.cat==='all'&&!String(state.q||'').trim(); const mx=+((state.site||{}).maxProducts)||0; const cl=bfCols(); state.limit=home?cl*Math.max(2,Math.ceil((mx||0)/cl)):100000;   /* full rows only: 2 rows x cols (e.g. 3+3); a custom maxProducts is rounded UP to a whole row so no gap is left */ state.bfAll=0; }   /* home: first 2 rows only, the rest comes with "আরও দেখুন" */   /* only the home view is capped at 10 */
function updateLoadMore(){ try{ bfPgMore(); }catch(e){} try{ const es=$('emptyState'); if(es) es.classList.toggle('hidden',(state._list||[]).length>0); }catch(e){} const w=$('loadMoreWrap'); if(!w) return; w.classList.add('hidden'); return;
  const total=(state._list||[]).length, shown=$('productGrid').children.length, left=total-shown;
  w.classList.toggle('hidden',left<=0); if(left<=0) return;
  $('loadMoreInfo').textContent=bnum(total)+' টির মধ্যে '+bnum(shown)+' টি দেখানো হচ্ছে'; $('loadMoreBar').style.width=(shown/total*100)+'%';
  $('loadMoreBtn').innerHTML='আরও দেখুন ('+bnum(Math.min(left,_pageSize()))+' টি) <i class="fa-solid fa-chevron-down"></i>'; }
function loadMore(){ const grid=$('productGrid'), list=state._list||[], from=grid.children.length; if(from>=list.length) return;
  const next=list.slice(from,from+_pageSize()); grid.insertAdjacentHTML('beforeend',next.map((p,k)=>state._card(p,k)).join(''));
  state.limit=from+next.length; [...grid.children].slice(from).forEach((c,k)=>{ c.style.setProperty('--pd',(Math.min(k,7)*.07).toFixed(2)+'s'); c.classList.add('in2'); }); updateLoadMore(); }

/* ===== HOME PRODUCT LIST: 2 rows -> "আরও দেখুন" line -> big 2-up showcase (3 rows) -> second "আরও দেখুন" ===== */
function bfCols(){ const big=!!(window.matchMedia&&matchMedia('(min-width:768px)').matches), s=state.site||{}, v=+(big?s.homeColsD:s.homeColsM); return (v>=1&&v<=6)?v:(big?4:3); }
function bfFeatCard(p,i,on){
  const off=p.oldPrice?Math.round((p.oldPrice-p.price)/p.oldPrice*100):0, wl=state.wishlist.includes(p.id);
  const im=(p.images&&p.images.length?p.images:[p.image]), all=im.length>1?[...im,im[0]]:im;
  return `<article class="bfx-card${on?' in':''}" data-pid="${esc(p.id)}" style="--d:${((i%2)*.1).toFixed(2)}s" onclick="openProduct('${p.id}')">
    <div class="bfx-img">
      ${off>0?`<span class="bfx-off">-${off}%</span>`:''}
      <button type="button" class="bfx-heart${wl?' on':''}" aria-label="Wishlist" onclick="event.stopPropagation();toggleWishlist('${p.id}')"><i class="${wl?'fa-solid':'fa-regular'} fa-heart"></i></button>
      <button type="button" class="bf-lk" aria-label="লিংক কপি করুন" title="প্রোডাক্টের লিংক কপি করুন" onclick="copyProdLink('${p.id}',this,event)"><i class="fa-solid fa-link"></i></button>
      <div class="pslide" data-n="${im.length}" data-i="0">${all.map(u=>`<img src="${esc(CLX(u,800))}" alt="${esc(p.title)}" loading="lazy" decoding="async" draggable="false" onerror="this.style.opacity=0">`).join('')}</div>
      ${im.length>1?`<div class="pdots">${im.map((_,k)=>`<span class="pdot${k?'':' bg-white'}"></span>`).join('')}</div>`:''}
    </div>
    <div class="bfx-info">${p.badge?`<span class="pc-brand">${esc(badgeBn(p.badge))}</span>`:''}<h3>${esc(p.title)}</h3>
      <div class="bfx-row"><div class="bfx-pr"><b>${money(p.price)}</b>${p.oldPrice?`<s>${money(p.oldPrice)}</s>`:''}</div>
      <button type="button" class="bfx-add" aria-label="Add to cart" onclick="event.stopPropagation();addToCart('${p.id}',1,'${(p.sizes&&p.sizes[0])||'M'}')"><i class="fa-solid fa-plus"></i></button></div>
    </div></article>`;
}
const bfxIO=('IntersectionObserver' in window)?new IntersectionObserver(es=>es.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('in'); bfxIO.unobserve(en.target); } }),{threshold:.08,rootMargin:'0px 0px -5% 0px'}):null;
function bfPgMore(){
  const w=$('bfMore1'), fs=$('bfFeat'), g=$('bfFeatGrid'), w2=$('bfMore2'), grid=$('productGrid'); if(!w||!fs||!g||!w2||!grid) return;
  const list=state._list||[], shown=grid.querySelectorAll('.pcard').length, more=shown>0&&list.length>shown;
  w.classList.toggle('on',more);
  const rest=more?list.slice(shown):[];
  fs.classList.toggle('on',rest.length>0);
  if(!rest.length){ g.innerHTML=''; g._sig=''; w2.classList.remove('on'); return; }
  const full=!!state.bfAll, vis=full?rest:rest.slice(0,6);
  w2.classList.toggle('on',!full&&rest.length>6);
  const sig=vis.map(p=>p.id+'|'+(state.wishlist.includes(p.id)?1:0)+'|'+p.price+'|'+(p.image||'')).join(',');
  if(g._sig===sig) return;
  const prev=g.children.length; g._sig=sig;
  g.innerHTML=vis.map((p,i)=>bfFeatCard(p,i,i<prev)).join('');
  [...g.children].forEach(c=>{ if(!c.classList.contains('in')){ if(bfxIO) bfxIO.observe(c); else c.classList.add('in'); } });
}
function bfShowAll(){   /* 1st "আরও দেখুন": every product, 3 per row */
  const grid=$('productGrid'), list=state._list||[], from=grid.querySelectorAll('.pcard').length; if(from>=list.length) return;
  state.limit=100000;
  grid.insertAdjacentHTML('beforeend',list.slice(from).map((p,k)=>state._card(p,k)).join(''));
  [...grid.querySelectorAll('.pcard')].slice(from).forEach((c,k)=>{ c.style.setProperty('--pd',(Math.min(k,7)*.07).toFixed(2)+'s'); c.classList.add('in2'); });
  bfPgMore();
}
function bfShowAll2(){ state.bfAll=1; bfPgMore(); }   /* 2nd "আরও দেখুন": rest of the showcase, 2 per row */
window.bfShowAll=bfShowAll; window.bfShowAll2=bfShowAll2;
window.renderProducts=renderProducts;
function renderHangerRail(base){
  const sec=document.getElementById('hangerRail'), st=document.getElementById('hrStage'); if(!sec||!st) return;
  const home=state.cat==='all'&&!String(state.q||'').trim();
  const items=home?base.slice().sort(_ordCmp).slice(0,6):[];
  if(!items.length){ sec.classList.add('hidden'); return; }
  const rot=[-2.4,1.8,-1.6,2.2,-2,1.5], n=items.length, k=Math.max(n-1,1);
  const hook='<svg class="hr-hanger" viewBox="0 0 100 38" aria-hidden="true"><path d="M50 17V7.5a4.2 4.2 0 1 1 4.2 4.2" fill="none" stroke="#111" stroke-width="2.4" stroke-linecap="round"/><path d="M50 17L8 33.5Q5 35.5 8.5 36.5L91.5 36.5Q95 35.5 92 33.5Z" fill="none" stroke="#111" stroke-width="2.4" stroke-linejoin="round"/></svg>';
  st.style.setProperty('--k',k);
  st.innerHTML=items.map((p,i)=>{ const im=(p.images&&p.images.length?p.images[0]:p.image)||''; return '<div class="hr-item'+(i===0?' on':'')+'" data-pid="'+esc(p.id)+'" style="--i:'+i+';--r:'+rot[i%6]+'deg;z-index:'+(n-i)+'" onclick="hrTap(this)" onmouseenter="hrHover(this)">'+hook+'<div class="hr-frame"><img src="'+esc(CLX(im,700))+'" alt="'+esc(p.title)+'" decoding="async"'+(i>1?' loading="lazy"':'')+' draggable="false"></div><div class="hr-tag"><b>'+esc(p.title)+'</b><span>'+money(p.price)+'</span></div></div>'; }).join('');
  sec.classList.remove('hidden');
}
function hrOn(el){ el.parentNode.querySelectorAll('.hr-item.on').forEach(x=>x.classList.remove('on')); el.classList.add('on'); }
function hrHover(el){ if(window.matchMedia&&matchMedia('(hover:hover)').matches) hrOn(el); }
function hrTap(el){ if(el.classList.contains('on')) openProduct(el.getAttribute('data-pid')); else hrOn(el); }
window.hrTap=hrTap; window.hrHover=hrHover; window.hrOn=hrOn;
function renderProducts(){
  if(window.__pgDown&&Date.now()-window.__pgDown<1500){ window.__pgPend=1; return; }   /* a press is in progress: redraw right after release, so the tap is never lost */
  const grid=$('productGrid'); renderEid();
  if(FIREBASE_READY&&!state.loaded){ $('emptyState').classList.add('hidden'); grid.classList.remove('hidden'); grid.innerHTML=Array.from({length:8},()=>'<div class="rounded-2xl overflow-hidden bg-white border border-slate-200"><div class="aspect-[4/5] bg-slate-200 animate-pulse"></div><div class="p-4 space-y-2"><div class="h-3 w-2/3 bg-slate-200 rounded animate-pulse"></div><div class="h-3 w-1/3 bg-slate-200 rounded animate-pulse"></div></div></div>').join(''); return; }
  /* admin "Show on Homepage": the default view (all categories, no search) lists only the selected products; if none is selected yet, everything shows */
  let base=state.products.filter(p=>!p._rail);
  if(state.cat==='all'&&!String(state.q||'').trim()){ const sel=base.filter(p=>p.home===true||p.home==='true'); if(sel.length) base=sel; }
  let list=base.filter(p=>inCategory(p,state.cat)&&(String(p.title||'')+' '+String(p.description||'')).toLowerCase().includes(String(state.q||'').toLowerCase()));
  if(state.sort==='low') list.sort((a,b)=>_num(a.price)-_num(b.price));
  else if(state.sort==='high') list.sort((a,b)=>_num(b.price)-_num(a.price));
  else if(state.sort==='rating') list.sort((a,b)=>(_num(b.rating)-_num(a.rating))||(_num(b.reviews)-_num(a.reviews)));
  else list.sort(_ordCmp);
  if(!state.limit) resetLimit();
  $('emptyState').classList.toggle('hidden',list.length>0); try{ const pc=$('pgCount'); if(pc) pc.innerHTML='<b>'+bnum(list.length)+'</b>টি পণ্য পাওয়া গেছে'; }catch(e){} setTimeout(()=>grid.querySelectorAll('.pcard').forEach(c=>pio.observe(c)),0);
  grid.classList.toggle('hidden',list.length===0);
  const cardHTML=(p,i)=>{
    const off=p.oldPrice?Math.round((p.oldPrice-p.price)/p.oldPrice*100):0, wl=state.wishlist.includes(p.id);
    return `<div class="pcard reveal in group bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col cursor-pointer" data-pid="${esc(p.id)}" style="--pd:${(i%4)*.08}s" onclick="openProduct('${p.id}')">
      <div class="relative overflow-hidden bg-ink-800 aspect-[4/5]">
        ${off>0?`<span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-full bg-black text-white font-extrabold text-[11px]">-${off}%</span>`:''}
        <button onclick="event.stopPropagation();toggleWishlist('${p.id}')" class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-white/90 hover:bg-white flex items-center justify-center transition-all ${wl?'text-rose-500':'text-slate-700'}"><i class="${wl?'fa-solid':'fa-regular'} fa-heart"></i></button>
        <button type="button" class="bf-lk" aria-label="লিংক কপি করুন" title="প্রোডাক্টের লিংক কপি করুন" onclick="copyProdLink('${p.id}',this,event)"><i class="fa-solid fa-link"></i></button>
        ${(()=>{ const im=(p.images&&p.images.length?p.images:[p.image]); const all=im.length>1?[...im,im[0]]:im; return `<div class="pslide flex h-full" data-n="${im.length}" data-i="0" style="transition:transform .8s cubic-bezier(.65,0,.35,1)">${all.map(u=>`<img src="${esc(CLX(u,800))}" alt="${esc(p.title)}" loading="lazy" decoding="async" class="w-full h-full object-cover shrink-0" onerror="this.style.opacity=0">`).join('')}</div>${im.length>1?`<div class="pdots absolute bottom-3 right-3 z-10 flex gap-1">${im.map((_,k)=>`<span class="pdot w-1.5 h-1.5 rounded-full ${k?'bg-white/50':'bg-white'}"></span>`).join('')}</div>`:''}`; })()}
        <div class="hidden sm:flex absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity justify-center"><span class="w-full py-2.5 rounded-xl bg-white text-ink-900 text-center font-extrabold text-xs">দেখুন ও অর্ডার করুন <i class="fa-solid fa-arrow-right ml-1"></i></span></div>
      </div>
      <div class="p-3 sm:p-5 flex-1 flex flex-col justify-between">
        <div>
          ${p.badge?`<span class="pc-brand">${esc(badgeBn(p.badge))}</span>`:''}
          <h3 class="font-bold text-xs sm:text-[13px] text-ink-900 line-clamp-1 text-center">${esc(p.title)}</h3>${p.description?`<p class="text-[10.5px] sm:text-[11.5px] text-slate-500 leading-snug line-clamp-1 mt-0.5">${esc(p.description)}</p>`:''}
        </div>
        <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100">
          <div><span class="font-lux font-extrabold text-sm sm:text-base text-ink-900">${money(p.price)}</span>${p.oldPrice?`<span class="text-[11px] text-slate-400 line-through ml-1">${money(p.oldPrice)}</span>`:''}</div>
          <button onclick="event.stopPropagation();addToCart('${p.id}',1,'${(p.sizes&&p.sizes[0])||'M'}')" class="w-9 h-9 rounded-xl bg-ink-900 text-white hover:bg-gold-500 hover:text-black transition-all"><i class="fa-solid fa-plus text-xs"></i></button>
        </div>
      </div>
    </div>`;
  };
  state._list=list; state._card=cardHTML;
  grid.innerHTML=list.slice(0,state.limit).map(cardHTML).join('');
  updateLoadMore(); try{ renderHangerRail(base); }catch(e){}
}

/* ===== product card auto image slider ===== */
setInterval(()=>{ if(document.hidden) return; let q=0; document.querySelectorAll('.pslide').forEach(el=>{ const n=+el.dataset.n; if(n<2||el._sl||el.closest('.pcard:hover')) return; const _r=el.getBoundingClientRect(); if(!_r.height||_r.bottom<0||_r.top>innerHeight) return;
  const nx=el.children[(+el.dataset.i)+1];
  const slide=()=>{ if(!el.isConnected){ el._sl=0; return; } const i=+el.dataset.i+1; el.style.willChange='transform'; el.style.transition='transform .8s cubic-bezier(.65,0,.35,1)'; el.style.transform=`translateX(-${i*100}%)`; el.dataset.i=i;
    const dots=el.parentElement.querySelectorAll('.pdot'); dots.forEach((d,j)=>{ const on=j===(i%n); d.classList.toggle('bg-white',on); d.classList.toggle('bg-white/50',!on); });
    setTimeout(()=>{ if(!el.isConnected){ el._sl=0; return; } if(i>=n){ el.style.transition='none'; el.style.transform='translateX(0)'; el.dataset.i=0; } el.style.willChange=''; el._sl=0; },880); };
  el._sl=1; const d=(el._d!=null)?el._d:(el._d=(q++%4)*140);   /* fixed offset per card: every card holds each photo exactly 1 second */
  /* never slide to a picture that is not loaded AND decoded yet (that was the "bump") */
  const go=()=>setTimeout(slide,d);
  if(nx&&nx.tagName==='IMG'){ nx.loading='eager'; if(nx.decode){ Promise.race([nx.decode(),new Promise((_,rj)=>setTimeout(rj,2500))]).then(go,()=>{ el._sl=0; }); } else go(); } else go();
 }); },1800);   /* 0.8s glide + 1s hold */
/* robust category match: product.category may hold the id, the Bengali/English label, or differ in case/spacing */
const _nk=v=>String(v==null?'':(typeof v==='object'?_s(v):v)).trim().toLowerCase().replace(/\s+/g,' ');
const _catKeys={};
function catKeys(cid){ if(_catKeys[cid]) return _catKeys[cid]; const ks=new Set([_nk(cid)]), c=CATEGORIES.find(x=>x.id===cid); if(c) ks.add(_nk(c.label));
  if(CATBN[cid]) ks.add(_nk(CATBN[cid])); const raw=(state.cats||[]).find(x=>x.id===cid);
  if(raw) ['name','nameBn','name_bn','bn','label','title','slug'].forEach(k=>{ if(raw[k]) ks.add(_nk(raw[k])); }); ks.delete(''); return (_catKeys[cid]=ks); }
function inCategory(p,cid){ if(cid==='all') return true; const ks=catKeys(cid); if(ks.has(_nk(p.category))) return true; return Array.isArray(p.categories)&&p.categories.some(x=>ks.has(_nk(x))); }
function filterCategory(c){ hidePP(); state.cat=c; resetLimit(); if(state.q){ state.q=''; ['searchInput','mobileSearchInput'].forEach(id=>{ const e=$(id); if(e) e.value=''; }); } renderTabs(); pgSwap(renderProducts); }
function goShop(c){ filterCategory(c);
  const t=document.querySelector('#shop .pg-filterbar')||$('shop');
  const go=()=>{ let off=0; const h=document.querySelector('header'); if(h){ const cs=getComputedStyle(h); if(cs.position==='fixed'||cs.position==='sticky') off=h.getBoundingClientRect().height; }
    window.scrollTo({top:Math.max(0,t.getBoundingClientRect().top+window.pageYOffset-off-6),behavior:'smooth'}); };
  requestAnimationFrame(go); setTimeout(go,300); }
function handleSearch(v){ if(v&&document.body.classList.contains('pp-open')){ hidePP(); setTimeout(()=>$('shop').scrollIntoView(),30); } state.q=v; resetLimit(); $('searchInput').value=v; $('mobileSearchInput').value=v; renderProducts(); }
function setSort(v){ state.sort=v; resetLimit(); pgSwap(renderProducts); }
function resetFilters(){ state.cat='all'; state.q=''; resetLimit(); $('searchInput').value=''; $('mobileSearchInput').value=''; renderTabs(); renderProducts(); }

/* phase 2: the full list (all photos of every product) is fetched quietly AFTER the first paint, then cards are patched in place — no flicker, no hang */
function bfHydrate(){
  const PD=window.__PD||{}; if(!PD.full||state._hyd) return; state._hyd=1;
  const go=async()=>{
    try{
      const it=await PD.full(); if(!it||!it.length) return;
      if(PD.save) PD.save(it);
      const m=new Map(it.map(x=>[x.id,normProduct({...x})])), ch=[];
      state.products.forEach(p=>{ const f=m.get(p.id); if(!f||!f.images||!f.images.length) return; const a=p.images||[]; if(a.length===f.images.length&&a[0]===f.images[0]) return; p.images=f.images; ch.push(p.id); });
      ch.forEach(id=>{ const p=state.products.find(x=>x.id===id); if(!p||!p.images||p.images.length<2) return; const im=p.images;
        [...document.querySelectorAll('.pcard[data-pid]')].filter(c=>c.getAttribute('data-pid')===id).forEach(card=>{ const sl=card.querySelector('.pslide'); if(!sl) return;
          sl.dataset.n=im.length; sl.dataset.i=0; sl.style.transition='none'; sl.style.transform='translateX(0)';
          sl.innerHTML=[...im,im[0]].map(u=>`<img src="${esc(CLX(u,800))}" alt="${esc(p.title)}" loading="lazy" decoding="async" class="w-full h-full object-cover shrink-0" onerror="this.style.opacity=0">`).join('');
          if(!card.querySelector('.pdots')) sl.insertAdjacentHTML('afterend','<div class="pdots absolute bottom-3 right-3 z-10 flex gap-1">'+im.map((_,k)=>`<span class="pdot w-1.5 h-1.5 rounded-full ${k?'bg-white/50':'bg-white'}"></span>`).join('')+'</div>'); }); });
      if(ch.length&&document.body.classList.contains('pp-open')&&state.pp&&ch.includes(state.pp.id)){ const a=document.activeElement; if(!(a&&/INPUT|TEXTAREA/.test(a.tagName))){ try{ ppSafeRender(); }catch(e){} } }
    }catch(e){}
  };
  const kick=()=>{ (window.requestIdleCallback||(f=>setTimeout(f,300)))(go,{timeout:4000}); };
  if(document.readyState==='complete') setTimeout(kick,500); else addEventListener('load',()=>setTimeout(kick,500),{once:true});
}
async function loadFirestoreProducts(){
  try{ ['bana_products','bana_cache','bana_orders'].forEach(k=>{ if(FIREBASE_READY) localStorage.removeItem(k); }); }catch(e){}
  const _mk=p=>normProduct({rating:4.5,reviews:0,badge:null,description:'',oldPrice:null,...p}),
        _sig=l=>l.map(p=>[p.id,p.title,p.price,p.oldPrice,p.stock,p.home,p.category,p.badge,(p.images&&p.images.length)||0,String(p.image||'').length].join('~')).join('|');
  let _cs=null, _same=false; const PD=window.__PD||{};
  if(FIREBASE_READY){
    /* 1) cached list from the last visit -> products appear immediately */
    try{ const c=await Promise.race([PD.cache||Promise.resolve(null),new Promise(r=>setTimeout(()=>r(null),700))]);
      if(c&&c.items&&c.items.length){ state.products=c.items.map(_mk); state.loaded=true; _cs=_sig(state.products); renderProducts(); } }catch(e){}
    /* 2) fresh list, already downloading since the first byte (see PRODUCT PREFETCH in <head>) */
    try{ const it=PD.net?await PD.net:null; if(it){ const oldM=new Map((state.products||[]).map(x=>[x.id,x])); state.products=it.map(x=>{ const q=_mk(x), o=oldM.get(q.id); if(o&&o.images&&o.images.length&&!(q.images&&q.images.length)) q.images=o.images; return q; }); state.fetchOk=true; state._fast=true; } }catch(e){}
    /* 3) fallback: Firebase SDK, up to 3 attempts */
    for(let tryN=0;tryN<3&&!state.fetchOk;tryN++){      /* up to 3 attempts so a flaky connection does not leave the shop empty */
      try{
        const snap=await getDocs(collection(db,'products'));
        const items=[]; snap.forEach(d=>items.push({id:d.id,...d.data()}));
        state.products=items.map(p=>normProduct({rating:4.5,reviews:0,badge:null,description:'',oldPrice:null,...p})); state.fetchOk=true; state._fast=false; if(PD.save) PD.save(items);
      }catch(e){ console.warn('Firestore products not loaded (try '+(tryN+1)+'):',e.message); state.products=state.products||[]; if(tryN<2) await new Promise(r=>setTimeout(r,900*(tryN+1))); }
    }
  } else state.fetchOk=true;
  if(_cs!==null&&state.fetchOk) _same=(_cs===_sig(state.products));   /* nothing changed since the cached paint -> no re-render, no flicker */
  state.loaded=true;
  try{ if(RAIL.ready) railInject(); }catch(e){}
  /* drop cart / wishlist entries of deleted products and refresh price, title, image */
  if(state.fetchOk){ state.cart=state.cart.filter(i=>state.products.some(p=>p.id===i.id)).map(i=>{ const p=state.products.find(x=>x.id===i.id); return {...i,title:p.title,price:p.price,image:((i.image&&p.images&&p.images.includes(i.image))?i.image:((p.images&&p.images.length)?variantImg(p,i.size):''))||i.image||p.image||(p.images&&p.images[0])||''}; });
  state.wishlist=state.wishlist.filter(id=>state.products.some(p=>p.id===id)); save('bana_wish',state.wishlist); }
  if(!_same) renderProducts(); buildCatRow(); renderMenu(); updateCart(); updateWishlist(); openFromHash(); try{ if(state._fast) bfHydrate(); }catch(e){}
}

/* ===== ADMIN BANNERS: admin panel 'banners' collection -> home slider (shown before the built-in banners) ===== */
const BAN_CACHE='bana_banners_v1';
function bnrSlideHTML(b){
  const t=b.showText!==false, cat=esc(_s(b.cat)||'all'), title=esc(_s(b.title)), sub=esc(_s(b.sub)).replace(/\n/g,'<br>'), cta=esc(_s(b.cta)||'SHOP NOW');
  return `<div class="hero-slide bnr bnr-adm${t?'':' bnr-click'}" data-dur="5000" data-bid="${esc(b.id)}"${t?'':` onclick="goShop('${cat}')"`}>
    <img class="bnr-full" src="${esc(CLX(_url(b.image),1600))}" alt="${title}" decoding="async" draggable="false" onerror="this.style.opacity=0">
    ${t?`<div class="bnr-shade"></div><div class="bnr-txt">${title?`<h2 class="bnr-h">${title}</h2>`:''}${sub?`<p class="bnr-p">${sub}</p>`:''}<a href="#shop" onclick="goShop('${cat}');return false" class="bnr-btn">${cta} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>`:''}
  </div>`;
}
function applyBanners(list){
  const wrap=$('bnrWrap'); if(!wrap) return;
  const sig=JSON.stringify(list.map(b=>[b.id,b.title,b.sub,b.cta,b.cat,b.order,b.showText,String(_url(b.image)).length]));
  if(wrap._bsig===sig) return; wrap._bsig=sig;
  wrap.querySelectorAll('.bnr-adm').forEach(e=>e.remove());
  const first=wrap.querySelector('.hero-slide'), html=list.map(bnrSlideHTML).join('');
  if(html){ if(first) first.insertAdjacentHTML('beforebegin',html); else wrap.insertAdjacentHTML('beforeend',html); }
  if(!state.heroStarted){ const all=wrap.querySelectorAll('.hero-slide'); all.forEach(s=>s.classList.remove('active')); if(all[0]) all[0].classList.add('active'); }
  else restartHero();
}
async function loadBanners(){
  try{ const c=load(BAN_CACHE,[]); if(Array.isArray(c)&&c.length) applyBanners(c); }catch(e){}
  if(!FIREBASE_READY) return;
  try{
    const s=await getDocs(collection(db,'banners')), a=[]; s.forEach(d=>a.push({id:d.id,...d.data()}));
    const list=a.filter(b=>b&&_url(b.image)&&b.active!==false).sort((x,y)=>(+x.order||0)-(+y.order||0));
    applyBanners(list);
    const j=JSON.stringify(list); if(j.length<1200000) save(BAN_CACHE,list); else { try{ localStorage.removeItem(BAN_CACHE); }catch(e){} }
  }catch(e){ console.warn('banners not loaded:',e.message); }
}

/* ===== ADMIN-LINKED: site settings, categories, payment ===== */
/* payment numbers + logos from admin: wait for the (anonymous) login first, then listen live; retries if the first read is refused */
let _payUnsub=null,_payTry=0;
async function payWatch(){ if(!FIREBASE_READY||_payUnsub) return;
  try{ await Promise.race([authReady,new Promise(r=>setTimeout(r,4000))]); }catch(e){}
  try{ _payUnsub=onSnapshot(doc(db,'settings','payment'),s=>{ state.payCfg=s.exists()?s.data():{}; state.payErr=''; try{ renderPay(); }catch(e){} },
    err=>{ state.payErr=err&&err.code||'err'; console.warn('payment settings read failed ['+state.payErr+'] - Firestore rules must allow read on /settings/payment'); _payUnsub=null; if(_payTry++<3) setTimeout(payWatch,4000); }); }catch(e){} }
async function loadSite(){
  if(!FIREBASE_READY) return;
  payWatch();
  const [_rs,_rp,_rc]=await Promise.all([getDoc(doc(db,'settings','site')).catch(()=>null),getDoc(doc(db,'settings','payment')).catch(()=>null),getDocs(collection(db,'categories')).catch(()=>null)]);   /* 3 requests at once instead of one after another */
  try{ if(_rs&&_rs.exists()) state.site=_rs.data(); }catch(e){}
  try{ if(_rp&&_rp.exists()) state.payCfg=_rp.data(); }catch(e){}
  try{ const c=_rc; if(!c) throw 0; const a=[]; c.forEach(d=>a.push({id:d.id,...d.data()}));
    if(a.length){ a.sort((x,y)=>(x.order||0)-(y.order||0)); state.cats=a; for(const k in _catKeys) delete _catKeys[k]; CATEGORIES.splice(1,CATEGORIES.length-1,...a.map(x=>({id:x.id,label:catLabel(x)}))); buildCatRow(); renderTabs(); } }catch(e){} _catsFinal=true; buildCatRow();
  renderMenu(); renderEid();
  const st=state.site||{}; { const w=String(st.whatsapp||'').replace(/\D/g,''); if(w&&$('fabWa')) $('fabWa').href='https://wa.me/'+w; const hp=String(st.helpline||'').replace(/[^\d+]/g,''); if(hp&&$('fabTel')) $('fabTel').href='tel:'+hp; }
  window.SHOPX={...(st.shopAddress?{addr:st.shopAddress}:{}),...(st.helpline?{phone:st.helpline}:{})}; if(st.shipDhaka>=0) SHIP.dhaka=st.shipDhaka; if(st.shipOutside>=0) SHIP.outside=st.shipOutside; if(st.freeShip>=0) FREE_SHIP=st.freeShip||999999999; updateCart();
  try{ updateCheckoutTotals(); }catch(e){ console.warn('checkout totals:',e); }
  
  const d=+st.homeColsD||0, m=+st.homeColsM||0;
  let el=$('gridStyle'); if(!el){ el=document.createElement('style'); el.id='gridStyle'; document.head.appendChild(el); }
  el.textContent=(m||d)?`html body #productGrid{grid-template-columns:repeat(${Math.min(3,Math.max(1,m||3))},minmax(0,1fr))!important}@media(min-width:768px){html body #productGrid{grid-template-columns:repeat(${Math.min(6,Math.max(2,d||4))},minmax(0,1fr))!important}}`:'';
  resetLimit(); renderProducts();
}
const SVG_TIE='<svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M9 2h6l-1.2 3 1.7 12.2L12 22l-3.5-4.8L10.2 5z"/></svg>';
const SVG_PANT='<svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M7 2h10l1 20h-4.6L12 9.5 10.6 22H6z"/></svg>';
const CAT_ICONS=[[/t-?shirt|টি-?শার্ট|polo|পোলো/i,'<i class="fa-solid fa-vest"></i>'],[/panjabi|punjabi|পাঞ্জাবি|kurta/i,SVG_TIE],[/shirt|শার্ট/i,'<i class="fa-solid fa-shirt"></i>'],[/pant|প্যান্ট|jeans|জিন্স|trouser|shorts|শর্টস/i,SVG_PANT],[/watch|ঘড়ি/i,'<i class="fa-solid fa-stopwatch"></i>'],[/suit|সুট|jacket|hoodie|জ্যাকেট|হুডি|coat|three|থ্রি/i,'<i class="fa-solid fa-user-tie"></i>'],[/shoe|জুতা|sneaker|sandal/i,'<i class="fa-solid fa-shoe-prints"></i>'],[/belt|wallet|bag|ব্যাগ|বেল্ট/i,'<i class="fa-solid fa-bag-shopping"></i>']];
function catIcon(c){ const t=(c.id||'')+' '+catLabel(c)+' '+(CATBN[c.id]||''); for(const [re,ic] of CAT_ICONS) if(re.test(t)) return ic; return '<i class="fa-solid fa-tags"></i>'; }
let _catSig='', _catsFinal=false, _catWait=0, _catsPlayed=false;
const CAT_CACHE='bana_cats_v1';
/* placeholder circles keep the space reserved while the real list loads, so nothing below jumps */
function catSkeleton(r){ if(r.dataset.sk) return; r.dataset.sk='1'; _catSig=''; r.innerHTML=Array.from({length:6},()=>'<div class="cat-card sk"><span class="cat-ic"></span><h3 class="cat-name"></h3></div>').join(''); }
function buildCatRowCore(){ const r=$('catRow'); if(!r) return;
  const hasCats=!!(state.cats&&state.cats.length);
  let list;
  if(hasCats) list=state.cats;
  else if(!_catsFinal){
    const cc=load(CAT_CACHE,[]);                       /* last visit's list: shown instantly, refreshed silently */
    if(Array.isArray(cc)&&cc.length) list=cc;
    else { catSkeleton(r); if(!_catWait) _catWait=setTimeout(()=>{ _catsFinal=true; _catWait=0; buildCatRow(); },2500); return; }
  } else list=CATEGORIES.filter(c=>state.products.some(p=>p.category===c.id));
  list=list.filter(c=>c.id!=='all').slice(0,24);
  const sec=$('categories'); if(sec) sec.classList.toggle('hidden',!list.length&&_catsFinal);
  if(hasCats&&list.length) save(CAT_CACHE,list.map(c=>({id:c.id,label:catLabel(c),image:c.image||''})));
  const cnt=c=>state.products.filter(p=>p.category===c.id).length;
  const sig=list.map(c=>c.id+'|'+(c.image||'')+'|'+catLabel(c)).join('~');
  if(sig===_catSig&&r.children.length&&!r.dataset.sk){ list.forEach(c=>{ const el=r.querySelector('[data-cid="'+String(c.id).replace(/"/g,'')+'"] .cat-cnt'); if(el){ const n=cnt(c); el.textContent=n?bnum(n)+'+ পণ্য':''; } }); return; }
  _catSig=sig; delete r.dataset.sk;
  r.innerHTML=list.map((c,i)=>{ const name=catLabel(c)||String(c.id||''); const n=cnt(c);
    const pr=state.products.find(p=>p.category===c.id); const im=c.image||(pr&&(pr.image||(pr.images&&pr.images[0])))||'';
    return `<div onclick="goShop('${esc(c.id)}')" data-cid="${esc(c.id)}" style="--d:${(.1+i*.12).toFixed(2)}s;--f:${(i%6)*.35}s" class="cat-card group cursor-pointer"><span class="cat-ic">${catIcon(c)}${im?`<img src="${esc(CLX(im,200))}" alt="${esc(name)}" onerror="this.remove()">`:''}</span><h3 class="cat-name">${esc(name)}</h3><span class="cat-cnt">${n?bnum(n)+'+ পণ্য':''}</span></div>`; }).join('');
  if(catsInView||_catsPlayed) playCats(); }
/* ===== categories: 4 per row, 2 rows (8) first, then an "আরো দেখুন" button reveals the rest ===== */
let _catExp=false;
function buildCatRow(){ buildCatRowCore(); catMoreApply(); try{ bfcRender(); }catch(e){ console.warn("bfcRender:",e); } }
function catMoreApply(){ const r=$('catRow'); if(!r) return;
  const cards=[...r.querySelectorAll('.cat-card:not(.sk)')]; let w=$('catMoreWrap');
  if(cards.length<=8){ cards.forEach(c=>c.classList.remove('cat-extra')); r.classList.remove('cat-collapsed'); if(w) w.remove(); return; }
  cards.forEach((c,i)=>c.classList.toggle('cat-extra',i>=8));
  r.classList.toggle('cat-collapsed',!_catExp);
  if(!w){ w=document.createElement('div'); w.id='catMoreWrap'; r.after(w); }
  w.innerHTML='<button type="button" class="cat-more'+(_catExp?' open':'')+'" onclick="catMoreToggle()" aria-expanded="'+(_catExp?'true':'false')+'"><span class="cat-more-ic"><i class="fa-solid fa-chevron-down"></i></span><span>'+(_catExp?'কম দেখুন':'আরো দেখুন')+'</span></button>'; }
function catMoreToggle(){ _catExp=!_catExp; catMoreApply(); if(_catExp){ const r=$('catRow'); r.querySelectorAll('.cat-card').forEach(c=>{ c.classList.remove('lit'); c.classList.add('shown'); }); } }
window.catMoreToggle=catMoreToggle;
/* ===== NEW categories block: 4 per row, 2 rows; "আরও দেখুন" opens ALL categories as a sheet that rises from the bottom ===== */
let _bfcSig='', _bfcAll=[], _bfcOpen=false;
function bfcList(){
  let list=[];
  if(state.cats&&state.cats.length) list=state.cats.slice();                      /* the admin panel's categories (Firestore) */
  else { const cc=load(CAT_CACHE,[]); if(Array.isArray(cc)&&cc.length) list=cc.slice(); else list=CATEGORIES.filter(c=>c.id!=='all'&&state.products.some(p=>p.category===c.id)); }
  list=list.filter(c=>c&&c.id&&c.id!=='all');
  /* a product whose category is not in the admin list still gets its own circle, so no product is unreachable */
  const seen=new Set();
  (state.products||[]).forEach(p=>{ const raw=p.category; if(raw==null||typeof raw==='object') return; const v=String(raw).trim(), k=_nk(v); if(!v||seen.has(k)) return; seen.add(k);
    if(!list.some(c=>catKeys(c.id).has(k))) list.push({id:v,label:CATBN[v]||v,image:''}); });
  return list;
}
function bfcItem(c,i){
  const name=catLabel(c)||String(c.id||''), pr=(state.products||[]).find(p=>inCategory(p,c.id)), im=c.image||(pr&&(pr.image||(pr.images&&pr.images[0])))||'';
  return `<button type="button" class="bfc-item" style="--i:${i}" onclick="bfcPick('${esc(c.id)}')" aria-label="${esc(name)}"><span class="bfc-ic">${catIcon(c)}${im?`<img src="${esc(CLX(im,200))}" alt="" loading="lazy" onerror="this.remove()">`:''}</span><span class="bfc-nm">${esc(name)}</span></button>`;
}
function bfcFill(){ const g=$('bfsGrid'); if(g) g.innerHTML=_bfcAll.map(bfcItem).join(''); const t=$('bfsCount'); if(t) t.textContent=bnum(_bfcAll.length)+' টি ক্যাটাগরি'; }
function bfcRender(){
  const sec=$('bfCats'); if(!sec) return;
  const list=bfcList(); _bfcAll=list;
  if(!list.length){ sec.style.display='none'; return; }
  sec.style.display='';
  const sig=list.map(c=>c.id+'|'+(c.image||'')+'|'+catLabel(c)).join('~')+'#'+(state.products||[]).length;
  if(sig===_bfcSig) return; _bfcSig=sig;
  $('bfcGrid').innerHTML=list.slice(0,8).map(bfcItem).join('');
  $('bfcMore').innerHTML=list.length>8?'<button type="button" class="bfc-more" onclick="bfcOpen()" aria-haspopup="dialog"><span>আরও দেখুন</span><b>+'+bnum(list.length-8)+'</b><i class="fa-solid fa-chevron-up"></i></button>':'';
  if(_bfcOpen) bfcFill();
}
function bfcOpen(){
  let sh=$('bfcSheet');
  if(!sh){ sh=document.createElement('div'); sh.id='bfcSheet';
    sh.innerHTML='<div class="bfs-bg" onclick="bfcClose()"></div><div class="bfs-panel" role="dialog" aria-modal="true" aria-label="সকল ক্যাটাগরি"><div class="bfs-grab" onclick="bfcClose()"><i></i></div><div class="bfs-top"><div><div class="bfs-ttl">সকল ক্যাটাগরি</div><div class="bfs-sub" id="bfsCount"></div></div><button type="button" class="bfs-x" onclick="bfcClose()" aria-label="বন্ধ করুন"><i class="fa-solid fa-xmark"></i></button></div><div class="bfs-body"><div id="bfsGrid" class="bfc-grid"></div></div></div>';
    document.body.appendChild(sh); }
  bfcFill(); _bfcOpen=true; document.body.style.overflow='hidden';
  sh.classList.remove('show'); sh.classList.add('open'); void sh.offsetWidth; requestAnimationFrame(()=>sh.classList.add('show'));
}
function bfcClose(){ const sh=$('bfcSheet'); if(!sh||!_bfcOpen) return; _bfcOpen=false; sh.classList.remove('show'); document.body.style.overflow=''; setTimeout(()=>{ if(!_bfcOpen) sh.classList.remove('open'); },520); }
function bfcPick(id){ if(_bfcOpen){ bfcClose(); setTimeout(()=>goShop(id),280); } else goShop(id); }
window.bfcOpen=bfcOpen; window.bfcClose=bfcClose; window.bfcPick=bfcPick;
document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&_bfcOpen) bfcClose(); });
/* ===== pencil-writing text + Bengali spacing fix ===== */
/* section headings are plain text now (the animated pencil icon was removed) */
function pencilInit(){ document.querySelectorAll('.penned').forEach(el=>{ const s=el.querySelector('.pen'); if(s) el.innerHTML=s.innerHTML; el.classList.remove('penned'); }); }
function bnFix(){ const BN=/[\u0980-\u09FF]/, SKIP=/^(SCRIPT|STYLE)$/;
  const fix=n=>{ if(BN.test(n.nodeValue)){ const el=n.parentElement; if(el&&!el.dataset.bnf&&!SKIP.test(el.tagName)){ el.dataset.bnf=1; el.style.letterSpacing='normal'; el.style.textTransform='none'; } } };
  const scan=root=>{ if(!root) return; if(root.nodeType===3){ fix(root); return; } if(root.nodeType!==1||!root.isConnected) return; const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT); let n; while((n=w.nextNode())) fix(n); };
  scan(document.body); let q=new Set(), t;
  new MutationObserver(ms=>{ for(const m of ms){ const el=m.target.nodeType===1?m.target:m.target.parentElement; if(el&&el.closest&&el.closest('.counter,#preloader')) continue; if(m.type==='characterData') q.add(m.target); else m.addedNodes.forEach(x=>q.add(x)); }
    if(!q.size) return; clearTimeout(t); t=setTimeout(()=>{ const a=[...q]; q=new Set(); a.forEach(scan); },200); }).observe(document.body,{childList:true,subtree:true,characterData:true}); }

function payIcon(k,m){ if(k==='cod') return '<span class="co-ico co-ico-cod"><i class="fa-solid fa-money-bill-wave"></i></span>';
  const c=PCOL[k]||['#555',String(k).toUpperCase()];
  const badge=`<span class="co-ico co-ico-badge" style="background:${c[0]}">${c[1]}</span>`;
  if(m&&m.logo){ const fb=badge.replace(/"/g,'&quot;'); return `<span class="co-ico co-ico-logo"><img src="${esc(m.logo)}" alt="${esc(c[1])}" loading="lazy" decoding="async" onerror="this.parentNode.outerHTML=this.dataset.fb" data-fb="${fb}"></span>`; }
  return badge; }
/* delivery charge must be paid online first whenever it is > 0 and at least one wallet number is saved in admin */
function advMandatory(){ const cfg=state.payCfg||{}; return shipCost()>0 && ['bkash','nagad','rocket','upay'].some(k=>cfg[k]&&cfg[k].number&&cfg[k].on!==false); }
function renderPay(){ const cfg=state.payCfg||{}, ship=shipCost(), free=ship===0;
  const isOn=k=>!!(cfg[k]&&cfg[k].number&&cfg[k].on!==false);               /* number saved in admin panel */
  const mfs=['bkash','nagad'].concat(['rocket','upay'].filter(isOn));        /* bKash & Nagad cards always show */
  const act=mfs.filter(isOn);
  if(free&&state.payM&&state.payM!=='cod') state.payM='cod';
  const req=!!(act.length&&!free); if(req&&(!state.payM||state.payM==='cod')) state.payM=act[0];
  if(state.payM&&state.payM!=='cod'&&!act.includes(state.payM)) state.payM='cod';
  state.payM=state.payM||'cod';
  $('coPayOpts').innerHTML=(req?[]:['cod']).concat(mfs).map(k=>{
    const ready=k==='cod'||isOn(k), on=state.payM===k, dis=!ready||(free&&k!=='cod');
    const sub=k==='cod'?'পণ্য হাতে পেয়ে টাকা দিন':(!ready?(state.payErr?'লোড হয়নি, রিফ্রেশ দিন':'শীঘ্রই আসছে'):(free?'ফ্রি ডেলিভারি':'ডেলিভারি চার্জ অগ্রিম'));
    return `<button type="button" ${dis?'disabled':`onclick="setPayM('${k}')"`} class="co-pay ${on?'on':''} ${dis?'dis':''}" role="radio" aria-checked="${on}">${payIcon(k,cfg[k])}<span class="leading-tight">${k==='cod'?'ক্যাশ অন ডেলিভারি':(PCOL[k]||[0,k])[1]}<small>${sub}</small></span><i class="fa-solid fa-circle-check co-chk"></i></button>`; }).join('');
  const adv=state.payM!=='cod'; $('coPayInfo').classList.toggle('hidden',!adv);
  const _pn=adv&&cfg[state.payM]?String(cfg[state.payM].number||''):'', _pl=(PCOL[state.payM]||[0,state.payM])[1], _dh=($('coArea')&&$('coArea').value==='dhaka');
  $('coPayMsg').innerHTML=adv?`<div class="co-pm"><div class="co-pm-amt"><span>${_dh?'ঢাকার ভিতরে ডেলিভারি চার্জ':'ঢাকার বাইরে ডেলিভারি চার্জ'}<small>এই টাকাটি আগে পাঠাতে হবে</small></span><b>${money(ship)}</b></div>
    <div class="co-pm-steps"><div><i>১</i><span>${_pl} অ্যাপ/ডায়াল থেকে নিচের নম্বরে <b>Send Money</b> করুন</span></div></div>
    <div class="co-pm-num"><div><small>${_pl} নম্বর (Personal)</small><b class="select-all">${esc(_pn)}</b></div><button type="button" onclick="copyNum('${esc(_pn)}')" aria-label="নম্বর কপি"><i class="fa-regular fa-copy"></i>কপি</button></div>
    <div class="co-pm-steps"><div><i>২</i><span>পাঠানো শেষে যে নম্বর থেকে পাঠালেন সেটি ও <b>TrxID</b> নিচে দিন</span></div></div>
    <div class="co-pm-note">বাকি টাকা পণ্য হাতে পেয়ে ক্যাশ অন ডেলিভারিতে দেবেন।</div></div>`:'';
  try{ syncDelChk(); }catch(e){}
}
function setPayM(k){ state.payM=k; renderPay(); }
async function loadMyOrders(){ const box=$('myOrders'); if(!box||!FIREBASE_READY||!state.user) return; box.innerHTML='<div class="text-silver-400">লোড হচ্ছে...</div>';
  try{ const s=await getDocs(query(collection(db,'orders'),where('uid','==',state.user.uid))); const a=[]; s.forEach(d=>a.push(d.data())); a.sort((x,y)=>(y.createdAt?.seconds||0)-(x.createdAt?.seconds||0)); state.my=a;
    box.innerHTML=a.map((o,i)=>`<div class="p-3 rounded-xl bg-white/5 border border-white/10"><div class="flex justify-between font-bold"><span>${esc(o.orderId)}</span><span class="text-gold-400 uppercase">${esc(o.status)}</span></div><div class="text-silver-400">${money(o.total)}${o.deliveryPaid?' · ডেলিভারি চার্জ পরিশোধিত ✔':''}</div><button onclick="showMyInv(${i})" class="text-gold-400 font-bold mt-1"><i class="fa-solid fa-file-invoice mr-1"></i>Invoice</button>${o.courier&&o.courier.tracking?`<a target="_blank" rel="noopener" class="text-gold-400 underline" href="https://steadfast.com.bd/t/${encodeURIComponent(o.courier.tracking)}">${esc(o.courier.name||'Courier')}: ${esc(o.courier.tracking)} — Track</a>`:''}</div>`).join('')||'<div class="text-silver-400">এখনো কোনো অর্ডার নেই</div>';
  }catch(e){ box.innerHTML=''; } }

/* ===== INVOICE + QR ===== */
const BNUM=n=>String(n).replace(/\d/g,d=>'০১২৩৪৫৬৭৮৯'[d]), BT=n=>'৳'+BNUM(Math.round(n||0).toLocaleString('en-US'));
const INV_PAY={bkash:'বিকাশ (bKash)',nagad:'নগদ (Nagad)',rocket:'রকেট (Rocket)',upay:'উপায় (Upay)'};
const INV_ST={pending:'অপেক্ষমান',confirmed:'কনফার্মড',shipped:'শিপড',delivered:'ডেলিভারড',cancelled:'বাতিল',returned:'রিটার্ন'};
const SX=()=>Object.assign({addr:'শফিপুর বাজার, কালিয়াকৈর, গাজীপুর',phone:'+৮৮০ ১৮৭৩-৯৫৮৩৩৯'},window.SHOPX||{});
function invHTML(o){
  const d=o.createdAt&&o.createdAt.toDate?o.createdAt.toDate():new Date(o.createdAt||Date.now()), pay=o.pay, due=(pay&&o.deliveryPaid)?(o.subtotal-(o.discount||0)):o.total;
  return `<div class="inv-head">
    <div style="min-width:0"><div style="display:flex;align-items:center;gap:12px"><img src="logo.png" alt="BANA FASHION" style="width:54px;height:54px;border-radius:12px;object-fit:contain;background:#fff;padding:4px" onerror="this.replaceWith(Object.assign(document.createElement('div'),{style:'width:54px;height:54px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;background:#fff;color:#0a0a0a',textContent:'BF'}))"><div><div style="font-size:22px;font-weight:800;letter-spacing:.14em;color:#fff;line-height:1.2">BANA FASHION</div><div style="font-size:11.5px;color:#bdbdbd;margin-top:2px">প্রিমিয়াম মেনস ফ্যাশন ব্র্যান্ড</div></div></div>
    <div style="font-size:12px;color:#d4d4d4;margin-top:14px;line-height:1.7"><i class="fa-solid fa-location-dot" style="margin-right:6px"></i>${esc(SX().addr)}<br><i class="fa-solid fa-phone" style="margin-right:6px"></i>হেল্পলাইন: <b style="color:#fff">${esc(SX().phone)}</b></div></div>
    <div style="text-align:right"><span class="inv-badge">ক্যাশ মেমো / INVOICE</span>
    <div style="font-size:11px;color:#bdbdbd;margin-top:10px">অর্ডার আইডি</div><div style="font-family:monospace;font-weight:800;font-size:19px;color:#fff;letter-spacing:.04em">${esc(o.orderId)}</div><div style="font-size:12px;color:#d4d4d4">তারিখ: ${d.toLocaleDateString('bn-BD',{day:'numeric',month:'long',year:'numeric'})}</div>
    <div style="display:inline-block;margin-top:10px;padding:6px;border-radius:10px;background:#fff"><div id="invQR"></div></div><div style="font-size:10.5px;color:#bdbdbd;margin-top:3px">স্ক্যান করে অর্ডার যাচাই করুন</div></div></div>
  <div class="inv-sec" style="margin-top:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px;font-size:13px;line-height:1.7">
    <div class="inv-card"><div class="inv-ttl">কাস্টমার তথ্য</div><div style="font-size:15px;font-weight:800">${esc(o.customerName)}</div><div>মোবাইল: <b>${esc(o.phone)}</b></div><div>ঠিকানা: ${esc(o.address)}${o.upazila?', '+esc(o.upazila):''}${o.district?', '+esc(o.district):''}</div></div>
    <div class="inv-card"><div class="inv-ttl">পেমেন্ট তথ্য</div>
    ${pay?`<div>ডেলিভারি চার্জ: <b>${INV_PAY[pay.method]||esc(pay.method)}</b></div><div>ট্রানজেকশন আইডি: <b style="font-family:monospace">${esc(pay.trxId)}</b></div><div>অবস্থা: <b>${o.deliveryPaid?'✔ ডেলিভারি চার্জ পরিশোধিত (PAID)':'ভেরিফিকেশন বাকি'}</b></div>`:'<div>পেমেন্ট মাধ্যম: <b>ক্যাশ অন ডেলিভারি</b></div>'}
    <div>অর্ডার স্ট্যাটাস: <b>${INV_ST[o.status]||esc(o.status)}</b></div></div></div>
  <div class="inv-sec" style="margin-top:20px;overflow-x:auto"><table><thead><tr style="text-align:left"><th>#</th><th>প্রোডাক্ট</th><th style="text-align:center">সাইজ</th><th style="text-align:center">পরিমাণ</th><th style="text-align:right">একক মূল্য</th><th style="text-align:right">মোট</th></tr></thead><tbody>
  ${(o.items||[]).map((i,n)=>`<tr><td>${BNUM(n+1)}</td><td style="font-weight:700">${esc(i.title)}</td><td style="text-align:center">${esc(i.size)}</td><td style="text-align:center">${BNUM(i.qty)}</td><td style="text-align:right">${BT(i.price)}</td><td style="text-align:right;font-weight:800">${BT(i.price*i.qty)}</td></tr>`).join('')}</tbody></table></div>
  <div class="inv-sec" style="margin-top:20px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:18px;font-size:13px">
    <div style="color:#525252;line-height:1.8;max-width:300px"><b style="color:#0a0a0a">শর্তাবলী</b><div>১. ডেলিভারিম্যানের সামনে দেখে চেক করে রিসিভ করুন।</div><div>২. সাইজ পরিবর্তনের জন্য ৩ দিনের মধ্যে যোগাযোগ করুন।</div></div>
    <div class="inv-sum" style="width:100%;max-width:320px"><div style="display:flex;justify-content:space-between;padding:3px 0"><span>সাবটোটাল</span><b>${BT(o.subtotal)}</b></div><div style="display:flex;justify-content:space-between;padding:3px 0"><span>ডেলিভারি চার্জ</span><b>${o.delivery?BT(o.delivery):'ফ্রি'}</b></div>${o.discount?`<div style="display:flex;justify-content:space-between;padding:3px 0"><span>প্রোমো ডিসকাউন্ট${o.promo?' ('+esc(o.promo.code)+')':''}</span><b>-${BT(o.discount)}</b></div>`:''}
    <div class="inv-grand"><span>সর্বমোট</span><span>${BT(o.total)}</span></div>
    <div style="display:flex;justify-content:space-between;padding:10px 2px 0;font-weight:800"><span>ক্যাশ অন ডেলিভারিতে দেবেন</span><span>${BT(due)}</span></div></div></div>
  <div class="inv-foot" style="margin-top:26px"><div style="text-align:center"><div style="width:130px;border-bottom:1.5px solid #0a0a0a;margin-bottom:5px"></div>গ্রাহকের স্বাক্ষর</div><div style="text-align:center"><div style="width:130px;border-bottom:1.5px solid #0a0a0a;margin-bottom:5px"></div><b style="color:#0a0a0a">Bana Fashion Authorized</b></div></div>
  <div class="inv-note">ধন্যবাদ — BANA FASHION</div>`;
}
function showInvoice(o){ const old=document.getElementById('invWrap'); if(old) old.remove(); const w=document.createElement('div'); w.id='invWrap'; w.className='fixed inset-0 z-[120] bg-black/85 overflow-y-auto p-3 sm:p-6'; w.onclick=e=>{ if(e.target===w) w.remove(); };
  w.innerHTML=`<div class="max-w-3xl mx-auto flex gap-2 justify-end mb-3 no-print bf-invbar"><button onclick="window.print()" class="font-bold px-5 py-2.5 rounded-xl text-sm" style="background:#fff;color:#0a0a0a"><i class="fa-solid fa-print mr-2"></i>প্রিন্ট / ডাউনলোড</button><button onclick="document.getElementById('invWrap').remove()" class="text-white font-bold px-4 py-2.5 rounded-xl text-sm" style="background:transparent;border:1.5px solid #fff"><i class="fa-solid fa-xmark mr-1.5"></i>বন্ধ করুন</button></div><div id="invSheet" class="max-w-3xl mx-auto bg-white text-black rounded-2xl" style="font-family:'Hind Siliguri',sans-serif">${invHTML(o)}</div>`;
  document.body.appendChild(w); try{ new QRCode(document.getElementById('invQR'),{text:location.origin+location.pathname+'?verify='+encodeURIComponent(o.orderId),width:88,height:88,correctLevel:QRCode.CorrectLevel.M}); }catch(e){} }

/* ===== ORDER TRACKING (live from admin / Steadfast sync) ===== */
const TRK_ST=['pending','confirmed','shipped','delivered'],TRK_L={pending:'অর্ডার গৃহীত',confirmed:'কনফার্মড',shipped:'কুরিয়ারে শিপড',delivered:'ডেলিভারড'},TRK_I={pending:'fa-bag-shopping',confirmed:'fa-circle-check',shipped:'fa-truck-fast',delivered:'fa-box-open'};
const TRK_LIVE={pending:'অপেক্ষমান',in_review:'কুরিয়ার রিভিউ চলছে',hold:'হোল্ডে আছে',delivered:'ডেলিভারড',partial_delivered:'আংশিক ডেলিভারড',cancelled:'বাতিল / রিটার্ন',delivered_approval_pending:'ডেলিভারড (অনুমোদন বাকি)',partial_delivered_approval_pending:'আংশিক ডেলিভারড',cancelled_approval_pending:'বাতিল (অনুমোদন বাকি)',unknown_approval_pending:'আপডেট হচ্ছে',unknown:'অজানা'};
let trkUnsub=null;
function trkSave(id){ try{ const a=JSON.parse(localStorage.getItem('bana_trk')||'[]').filter(x=>x!==id); a.unshift(id); localStorage.setItem('bana_trk',JSON.stringify(a.slice(0,5))); }catch(e){} }
function trkList(){ try{ return JSON.parse(localStorage.getItem('bana_trk')||'[]'); }catch(e){ return []; } }
function openTrack(id){
  closeTrack();
  const w=document.createElement('div'); w.id='trkWrap'; w.className='fixed inset-0 z-[135] bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4'; w.onclick=e=>{ if(e.target===w) closeTrack(); };
  const rec=trkList();
  w.innerHTML=`<div class="pop w-full max-w-md rounded-t-3xl sm:rounded-3xl bg-ink-900 border border-gold-500/30 text-white p-5 max-h-[92vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-3"><div class="font-display font-extrabold tracking-wider"><i class="fa-solid fa-truck-fast text-gold-400 mr-2"></i>অর্ডার ট্র্যাক করুন</div><button type="button" onclick="closeTrack()" class="bf-x" aria-label="বন্ধ করুন"><i class="fa-solid fa-xmark"></i></button></div>
    <form onsubmit="event.preventDefault();doTrack($('trkIn').value);" class="flex gap-2"><input id="trkIn" class="flex-1 min-w-0 px-3 py-3 rounded-xl bg-black/50 border border-white/15 text-sm uppercase tracking-wider outline-none focus:border-gold-500" placeholder="অর্ডার আইডি (যেমন BF-XXXX)" autocomplete="off"><button class="btn-gold px-4 rounded-xl font-extrabold text-sm">খুঁজুন</button></form>
    ${rec.length?`<div class="flex flex-wrap gap-1.5 mt-2">${rec.map(r=>`<button type="button" onclick="doTrack('${esc(r)}')" class="text-[11px] px-2.5 py-1 rounded-full bg-white/5 border border-white/15 text-silver-300 font-bold">${esc(r)}</button>`).join('')}</div>`:''}
    <div id="trkOut" class="mt-4"></div></div>`;
  document.body.appendChild(w);
  const first=id||rec[0]; if(first){ $('trkIn').value=first; doTrack(first); }
}
function closeTrack(){ if(trkUnsub){ try{trkUnsub();}catch(e){} trkUnsub=null; } const w=$('trkWrap'); if(w) w.remove(); }
function doTrack(raw){
  const id=String(raw||'').trim().toUpperCase(), out=$('trkOut'); if(!out) return;
  if(trkUnsub){ try{trkUnsub();}catch(e){} trkUnsub=null; }
  if(!id){ out.innerHTML=''; return; }
  $('trkIn').value=id;
  if(!FIREBASE_READY){ out.innerHTML='<div class="text-sm text-silver-400">সার্ভারের সাথে সংযোগ নেই।</div>'; return; }
  out.innerHTML='<div class="text-sm text-silver-400"><i class="fa-solid fa-spinner fa-spin mr-2"></i>খোঁজা হচ্ছে...</div>';
  const draw=r=>{
    if(!r){ out.innerHTML='<div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-sm"><i class="fa-solid fa-circle-exclamation mr-1"></i>এই আইডিতে কোনো অর্ডার পাওয়া যায়নি। আইডি আবার চেক করুন।</div>'; return; }
    const st=r.status||'pending', bad=st==='cancelled'||st==='returned', idx=Math.max(0,TRK_ST.indexOf(st));
    const steps=TRK_ST.map((k,i)=>{ const on=!bad&&i<=idx; return `<div class="flex items-center gap-3"><span class="w-9 h-9 rounded-full flex items-center justify-center text-sm flex-none ${on?'btn-gold':'bg-white/5 text-silver-400 border border-white/10'}"><i class="fa-solid ${TRK_I[k]}"></i></span><div class="text-sm ${on?'font-extrabold text-white':'text-silver-400'}">${TRK_L[k]}${!bad&&i===idx?' <span class="text-[10px] text-gold-400 font-bold ml-1">● বর্তমান</span>':''}</div></div>`; }).join('<div class="ml-[17px] h-3 border-l border-white/15"></div>');
    out.innerHTML=`<div class="rounded-2xl bg-white/5 border border-white/10 p-4">
      <div class="flex justify-between items-start gap-2"><div><div class="text-[10px] text-silver-400">অর্ডার আইডি</div><div class="font-extrabold tracking-wider text-gold-400">${esc(r.orderId||id)}</div></div><div class="text-right"><div class="text-[10px] text-silver-400">মোট</div><div class="font-extrabold">${money(r.total||0)}</div></div></div>
      ${r.name?`<div class="text-xs text-silver-300 mt-1">${esc(r.name)}</div>`:''}
      ${bad?`<div class="mt-3 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-sm font-bold">${st==='cancelled'?'এই অর্ডারটি বাতিল করা হয়েছে।':'এই অর্ডারটি রিটার্ন/রিজেক্ট হয়েছে।'}</div>`:`<div class="mt-4">${steps}</div>`}
      ${r.tracking?`<div class="mt-4 p-3 rounded-xl bg-black/40 border border-gold-500/25 text-xs"><div class="text-silver-400">${esc(r.courier||'কুরিয়ার')} ট্র্যাকিং কোড</div><div class="font-mono font-extrabold text-base text-white mt-0.5 break-all">${esc(r.tracking)}</div>${r.live?`<div class="mt-1 text-gold-400 font-bold"><i class="fa-solid fa-satellite-dish mr-1"></i>${esc(TRK_LIVE[r.live]||r.live)}</div>`:''}<a href="https://steadfast.com.bd/t/${encodeURIComponent(r.tracking)}" target="_blank" rel="noopener" class="inline-block mt-2 text-gold-400 underline font-bold">কুরিয়ারের সাইটে দেখুন <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i></a></div>`:''}
      <div class="text-[10px] text-silver-400 mt-3"><i class="fa-solid fa-rotate mr-1"></i>এই পেজ নিজে থেকেই আপডেট হয়</div></div>`;
  };
  try{ trkUnsub=onSnapshot(doc(db,'receipts',id),s=>{ draw(s.exists()?s.data():null); if(s.exists()) trkSave(id); },()=>draw(null)); }catch(e){ draw(null); }
}

function showLastInv(){ if(state.lastOrder) showInvoice({...state.lastOrder,createdAt:new Date()}); }
function showMyInv(i){ if(state.my&&state.my[i]) showInvoice(state.my[i]); }
function copyNum(n){ const done=()=>toast('নম্বর কপি হয়েছে: '+n); if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(n).then(done,done); else { const t=document.createElement('textarea'); t.value=n; document.body.appendChild(t); t.select(); try{document.execCommand('copy')}catch(e){} t.remove(); done(); } }
/* Copies this product's share link (https://site/?product=ID) - works on http/old browsers too */
function prodLink(id){ return location.origin+location.pathname+'?product='+encodeURIComponent(id); }
function copyProdLink(id,btn,ev){
  if(ev){ try{ ev.stopPropagation(); ev.preventDefault(); }catch(e){} }
  const url=prodLink(id);
  const done=()=>{ toast('প্রোডাক্টের লিংক কপি হয়েছে ✓'); if(!btn) return; btn.classList.add('ok'); const ic=btn.querySelector('i'); if(ic) ic.className='fa-solid fa-check'; setTimeout(()=>{ btn.classList.remove('ok'); if(ic) ic.className='fa-solid fa-link'; },1700); };
  const fallback=()=>{ const t=document.createElement('textarea'); t.value=url; t.setAttribute('readonly',''); t.style.cssText='position:fixed;top:0;left:0;opacity:0'; document.body.appendChild(t); t.focus(); t.select(); try{ t.setSelectionRange(0,url.length); }catch(e){} let ok=false; try{ ok=document.execCommand('copy'); }catch(e){} t.remove(); if(ok) done(); else window.prompt('লিংকটি কপি করে নিন:',url); };
  if(navigator.clipboard&&window.isSecureContext) navigator.clipboard.writeText(url).then(done,fallback); else fallback();
}
/* TrxID is NOT verified at checkout any more: any value is accepted, admin checks the payment later */
let trxT; function chkTrx(){ const el=$('coTrxErr'); if(el) el.textContent=''; }
async function verifyOrder(){ const id=new URLSearchParams(location.search).get('verify'); if(!id||!FIREBASE_READY) return; let r=null; try{ const sn=await getDoc(doc(db,'receipts',id)); if(sn.exists()) r=sn.data(); }catch(e){}
  const w=document.createElement('div'); w.className='fixed inset-0 z-[130] bg-black/85 flex items-center justify-center p-4';
  w.innerHTML=`<div class="pop bg-white rounded-3xl p-8 max-w-sm w-full text-center"><div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center text-3xl ${r?'bg-emerald-100 text-emerald-600':'bg-red-100 text-red-500'}"><i class="fa-solid ${r?'fa-circle-check':'fa-circle-xmark'}"></i></div><h3 class="font-display font-extrabold text-xl mt-3">${r?'Order Verified':'Invalid Order'}</h3>${r?`<div class="mt-3 p-3 rounded-xl bg-slate-100 text-xs space-y-1"><div>অর্ডার আইডি: <b class="font-mono">${esc(r.orderId)}</b></div><div>কাস্টমার: <b>${esc(r.name||'')}</b></div><div>স্ট্যাটাস: <b class="uppercase text-gold-600">${esc(r.status)}</b></div><div>মোট: <b>${money(r.total)}</b></div></div>`:`<p class="text-xs text-slate-500 mt-2">No order found with this ID: ${esc(id)}</p>`}<button onclick="this.closest('.fixed').remove()" class="mt-5 w-full py-3 rounded-xl btn-gold font-extrabold text-xs">Close</button></div>`; document.body.appendChild(w); }

/* ===== GPS LOCATION AUTO-FILL ===== */
const DALIAS={chittagong:'Chattogram',comilla:'Cumilla',bogra:'Bogura',jessore:'Jashore',barisal:'Barishal',jhalakathi:'Jhalokati',jhalokathi:'Jhalokati','chapai nawabganj':'Chapainawabganj',netrakona:'Netrokona',maulvibazar:'Moulvibazar',"cox's bazar":"Cox's Bazar",coxsbazar:"Cox's Bazar",narsinghdi:'Narsingdi',laxmipur:'Lakshmipur',sirajgonj:'Sirajganj',khagrachari:'Khagrachhari',kishorganj:'Kishoreganj',gazipur:'Gazipur'};
const geoNorm=x=>String(x||'').toLowerCase().replace(/\b(district|division|city corporation|zila|upazila|upazilla|thana|police station|sadar)\b/g,'').replace(/\s+/g,' ').trim();
function geoDist(a){ const keys=Object.keys(BD); const c=[a.state_district,a.county,a.city,a.municipality,a.town,a.state&&!/division/i.test(a.state)?a.state:''];
  for(const n0 of c){ const n=geoNorm(n0); if(!n) continue; if(DALIAS[n]) return DALIAS[n]; const k=keys.find(k=>geoNorm(k)===n); if(k) return k; }
  for(const n0 of c){ const n=geoNorm(n0); if(!n) continue; const k=keys.find(k=>n.includes(geoNorm(k))); if(k) return k; }
  if(/dhaka/i.test(a.state||'')&&(a.city_district||a.suburb)) return 'Dhaka'; return ''; }
function geoUp(d,a){ const list=BD[d].split(','); const c=[a.city_district,a.suburb,a.quarter,a.neighbourhood,a.county,a.municipality,a.town,a.village,a.city,a.state_district];
  for(const n0 of c){ const n=geoNorm(n0); if(!n) continue; const k=list.find(u=>geoNorm(u)===n)||list.find(u=>geoNorm(u).length>3&&(n.includes(geoNorm(u))||geoNorm(u).includes(n))); if(k) return k; } return ''; }
function useMyLocation(){ const m=$('geoMsg'), b=$('geoBtn');
  if(!navigator.geolocation){ m.textContent='এই ডিভাইস/ব্রাউজারে লোকেশন সাপোর্ট নেই।'; return; }
  m.textContent='GPS দিয়ে লোকেশন খোঁজা হচ্ছে... অনুমতি দিন'; b.disabled=true; b.innerHTML='<i class="fa-solid fa-spinner fa-sp.title+' | '+DOC_TITLE;
}
function hidePP(){ if(!document.body.classList.contains('pp-open')) return; if(state.rvUnsub){ try{state.rvUnsub();}catch(e){} state.rvUnsub=null; } document.body.classList.remove('pp-open'); $('productPage').classList.add('hidden'); $('productPage').innerHTML=''; document.title=DOC_TITLE; }
function closeProduct(){ if(history.state&&history.state.pid){ history.back(); } else { hidePP(); if(location.hash.startsWith('#product-')){ try{ history.replaceState(null,'',location.pathname+location.search); }catch(e){} } setTimeout(()=>{ const sh=$('shop'); if(sh) sh.scrollIntoView(); },30); } }
/* Opens a product from a share link (?product=ID, kept in window.__DL) or from a legacy #product-ID hash.
   Landing straight on a product builds the history  [home] -> [product]  so Back / the arrow button always goes to the shop home page. */
function openFromHash(){
  let id=null, viaDL=false;
  if(window.__DL){ id=window.__DL; viaDL=true; }
  else { const m=location.hash.match(/^#product-(.+)$/); if(!m) return; id=decodeURIComponent(m[1]); }
  if(state.pp&&state.pp.id===id&&document.body.classList.contains('pp-open')){ window.__DL=null; return; }
  const p=(state.products||[]).find(x=>x.id===id);
  if(!p){ if(viaDL&&state.fetchOk){ window.__DL=null; toast('দুঃখিত, এই প্রোডাক্টটি এখন পাওয়া যাচ্ছে না',false); } return; }   /* not loaded yet -> try again after the product list arrives */
  window.__DL=null;
  if(history.state&&history.state.pid){ openProduct(id,false); return; }
  try{ history.replaceState({home:1},'',location.pathname+location.search); }catch(e){}
  openProduct(id,true);
}
window.addEventListener('popstate',e=>{ const pid=e.state&&e.state.pid; if(pid) openProduct(pid,false); else hidePP(); });
document.addEventListener('click',e=>{ const a=e.target.closest('a[href^="#"]'); if(!a||!document.body.classList.contains('pp-open')) return; const h=a.getAttribute('href'); if(!h||h.length<2||h.startsWith('#product-')||h==='#ppReviews') return; e.preventDefault(); hidePP(); try{ history.replaceState(null,'',location.pathname+location.search); }catch(_){} setTimeout(()=>{ const t=document.querySelector(h); if(t) t.scrollIntoView({behavior:'smooth'}); },30); });

function ppStars(r,cls='text-gold-500'){ r=Math.round(r||0); return `<span class="${cls} text-xs">${[1,2,3,4,5].map(i=>`<i class="${i<=r?'fa-solid':'fa-regular'} fa-star"></i>`).join('')}</span>`; }
function ppVarsHTML(p){
  const S=state.pp, sizes=(p.sizes&&p.sizes.length)?p.sizes:SIZES, cols=p.colors||[];
  return (cols.length?`<div class="mt-4"><div class="text-[11px] font-extrabold mb-1.5 uppercase tracking-wider">কালার: <span class="font-semibold text-slate-500 normal-case">${esc(S.color)}</span></div><div class="flex flex-wrap gap-1.5">${cols.map(c=>`<button onclick="ppColor('${esc(c).replace(/'/g,"\\'")}')" class="ppbtn flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-[11px] font-bold ${S.color===c?'border-ink-900 bg-ink-900 text-white':'border-slate-200 hover:border-ink-900'}"><span class="w-3 h-3 rounded-full border border-slate-300" style="background:${CSSCOL[c]||'#e5e7eb'}"></span>${esc(c)}</button>`).join('')}</div></div>`:'')+
  `<div class="mt-4"><div class="text-[11px] font-extrabold mb-1.5 uppercase tracking-wider">সাইজ: <span class="font-semibold text-slate-500 normal-case">${esc(S.size)}</span></div><div class="flex flex-wrap gap-1.5">${sizes.map(z=>`<button onclick="ppSize('${esc(z).replace(/'/g,"\\'")}')" class="ppbtn min-w-[2.6rem] px-3 py-1.5 rounded-md border text-[11px] font-extrabold ${S.size===z?'border-ink-900 bg-ink-900 text-white':'border-slate-200 hover:border-ink-900'}">${esc(z)}</button>`).join('')}</div></div>`;
}
function ppCurrent(){ return state.products.find(x=>x.id===state.pp.id); }
function ppSize(z){ state.pp.size=z; $('ppVars').innerHTML=ppVarsHTML(ppCurrent()); }
const ppView=p=>colorImgs(p,state.pp&&state.pp.color);   /* photos of the colour that is selected right now */
const ppTrackHTML=(p,im)=>im.map(u=>`<div class="ppsl" style="--bg:url('${esc(CLX(u,500))}')"><img src="${esc(CLX(u,2000))}" alt="${esc(p.title)}" decoding="async" onerror="this.style.opacity=0"></div>`).join('');
const ppNavHTML=(im,cur=0)=>im.length>1?`<button onclick="ppGo(-1,true)" aria-label="Previous" class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 shadow flex items-center justify-center"><i class="fa-solid fa-chevron-left text-xs"></i></button><button onclick="ppGo(1,true)" aria-label="Next" class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 shadow flex items-center justify-center"><i class="fa-solid fa-chevron-right text-xs"></i></button>
          <div class="absolute bottom-3 inset-x-0 flex justify-center gap-1.5">${im.map((_,k)=>`<span class="ppdot w-2 h-2 rounded-full ${k===cur?'bg-white':'bg-white/50'}"></span>`).join('')}</div>`:'';
const ppThumbsHTML=(im,cur=0)=>im.length>1?`<div class="flex gap-2.5 mt-3 overflow-x-auto pb-1">${im.map((u,k)=>`<button onclick="ppGo(${k})" aria-label="Photo ${k+1}" class="ppthumb shrink-0 w-16 sm:w-20 aspect-[4/5] rounded-lg overflow-hidden border-2 ${k===cur?'border-ink-900':'border-transparent'} bg-silver-100"><img src="${esc(CLX(u,200))}" class="w-full h-full object-contain" onerror="this.style.opacity=0"></button>`).join('')}</div>`:'';
function ppGal(){   /* swap the gallery to the photos of the selected colour (with a soft fade) */
  const p=ppCurrent(), tr=$('ppTrack'); if(!p||!tr) return;
  const im=ppView(p), S=state.pp; S.img=0;
  tr.style.transition='none'; tr.style.opacity='0'; tr.style.transform='translateX(-0%)'; tr.innerHTML=ppTrackHTML(p,im);
  if($('ppNav')) $('ppNav').innerHTML=ppNavHTML(im,0);
  if($('ppThumbs')) $('ppThumbs').innerHTML=ppThumbsHTML(im,0);
  void tr.offsetWidth; tr.style.transition='opacity .4s ease'; tr.style.opacity='1';
  setTimeout(()=>{ if($('ppTrack')===tr) tr.style.transition='transform .5s cubic-bezier(.65,0,.35,1)'; },420);
}
function ppColor(c){
  const p=ppCurrent(); if(!p) return; state.pp.color=c; $('ppVars').innerHTML=ppVarsHTML(p);
  if(p._rail){ const k=(p.colors||[]).indexOf(c); if(k>=0) ppGo(k); return; }
  ppGal();
}
function ppQty(d){ const p=ppCurrent(), st=stockOf(p), mx=(st&&st>0)?st:99; state.pp.qty=Math.max(1,Math.min(mx,state.pp.qty+d)); $('ppQ').textContent=state.pp.qty; }
function ppGo(i,rel){ const p=ppCurrent(), n=ppView(p).length||1; if(rel) i=state.pp.img+i; state.pp.img=(i+n)%n; $('ppTrack').style.transform=`translateX(-${state.pp.img*100}%)`; document.querySelectorAll('.ppthumb').forEach((t,k)=>{ t.classList.toggle('border-ink-900',k===state.pp.img); t.classList.toggle('border-transparent',k!==state.pp.img); }); const dots=document.querySelectorAll('.ppdot'); dots.forEach((d,k)=>d.classList.toggle('bg-white',k===state.pp.img)); }
function ppAdd(buy){
  if(buy){ const _t=Date.now(); if(_t-(window.__buyT||0)<600) return; window.__buyT=_t; }
  const p=ppCurrent(), S=state.pp; if(!p) return; const st=stockOf(p);
  if(st!==null&&st<=0){ toast('দুঃখিত, এই পণ্যটির স্টক শেষ',false); return; }
  const variant=S.size+(S.color?' / '+S.color:''), img=(p._rail?variantImg(p,variant):(ppView(p)[S.img]||variantImg(p,variant)))||p.image||'';
  if(buy){
    /* BUY NOW: open the order form straight away with only this product (cart is not touched) */
    state.buyNow={id:p.id,title:p.title,price:p.price,image:img,size:variant,qty:S.qty};
    openCheckout(); return;
  }
  /* ADD TO CART: fly the product image from the gallery (if visible) or the button to the bag icon */
  const stg=$('ppStage'), sr=stg?stg.getBoundingClientRect():null, br=$('ppAddBtn').getBoundingClientRect();
  state.flyFrom=(sr&&sr.bottom>120&&sr.top<innerHeight-120)?{left:sr.left+sr.width/2-30,top:Math.max(sr.top,80)+Math.min(sr.height,innerHeight-120)/2-30,width:60,height:60}:br;
  addToCart(p.id,S.qty,variant,false,img);
}
function ppHeart(btn,id){ toggleWishlist(id); const on=state.wishlist.includes(id); btn.className=btn.className.replace(/text-rose-500|text-slate-700/,on?'text-rose-500':'text-slate-700'); btn.querySelector('i').className=(on?'fa-solid':'fa-regular')+' fa-heart'; }
function ppSlide(p){ const im=ppImgs(p), all=im.length>1?[...im,im[0]]:im; return `<div class="pslide flex h-full" data-n="${im.length}" data-i="0">${all.map(u=>`<img src="${esc(CLX(u,800))}" alt="${esc(p.title)}" loading="lazy" decoding="async" class="w-full h-full object-cover shrink-0" onerror="this.style.opacity=0">`).join('')}</div>`; }
function ppRelCard(p,i){
  const wl=state.wishlist.includes(p.id);
  return `<div class="pcard group cursor-pointer" style="--pd:${(i%4)*.08}s" onclick="openProduct('${p.id}')">
    <div class="relative overflow-hidden rounded-xl bg-silver-100 aspect-[3/4]">
      <span class="absolute top-2.5 left-2.5 z-10 px-2.5 py-1 bg-white text-ink-900 text-[11px] font-semibold rounded-sm">${esc(badgeBn(p.badge||'New'))}</span>
      <button onclick="event.stopPropagation();ppHeart(this,'${p.id}')" class="absolute top-2.5 right-2.5 z-10 w-9 h-9 rounded-full bg-white/95 flex items-center justify-center ${wl?'text-rose-500':'text-slate-700'}"><i class="${wl?'fa-solid':'fa-regular'} fa-heart"></i></button>
      ${ppSlide(p)}
    </div>
    <h3 class="mt-3 text-[13px] sm:text-sm font-medium text-ink-900 line-clamp-1">${esc(p.title)}</h3>
    <div class="mt-1 text-[12px] sm:text-sm">${p.oldPrice?`<span class="text-slate-400 line-through mr-1.5">${money(p.oldPrice)}</span>`:''}<span class="font-bold text-red-600">${money(p.price)}</span></div>
  </div>`;
}
function ppSafeRender(){ if(window.__ppDown&&Date.now()-window.__ppDown<1500){ window.__ppPend=1; return; } renderPP(); }
function ppFlush(){ if(window.__ppPend){ window.__ppPend=0; if(document.body.classList.contains('pp-open')&&state.pp){ try{ renderPP(); }catch(e){} } } }
window.ppFlush=ppFlush;
function renderPP(){
  const p=ppCurrent(), S=state.pp, im=ppView(p), st=stockOf(p);
  S.img=Math.min(S.img||0,Math.max(0,im.length-1));
  const off=(p.oldPrice&&p.oldPrice>p.price)?Math.round((p.oldPrice-p.price)/p.oldPrice*100):0;
  const stockHTML=st===null?`<div class="flex items-center gap-2 text-emerald-600 text-xs font-bold"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>স্টকে আছে</div>`
    :st<=0?`<div class="flex items-center gap-2 text-red-600 text-xs font-extrabold"><i class="fa-solid fa-circle-xmark"></i>স্টক শেষ</div>`
    :st<=10?`<div class="flex items-center gap-2 text-orange-600 text-xs font-extrabold animate-pulse"><i class="fa-solid fa-fire"></i>তাড়াতাড়ি করুন! মাত্র ${st} টি বাকি</div>`
    :`<div class="flex items-center gap-2 text-emerald-600 text-xs font-bold"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>স্টকে আছে</div>`;
  const dis=(st!==null&&st<=0)?'disabled':'';
  const pay=['bkash','nagad','rocket','upay'].map(k=>{ const c=(typeof PCOL!=='undefined'&&PCOL[k])||['#555',k]; return `<span class="px-2 py-0.5 rounded text-[9px] font-extrabold text-white" style="background:${c[0]}">${c[1]}</span>`; }).join('');
  $('productPage').innerHTML=`<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-5">
    <div class="flex items-center justify-between gap-3"><button onclick="closeProduct()" class="inline-flex items-center gap-2 text-xs font-bold text-slate-500 hover:text-ink-900"><i class="fa-solid fa-arrow-left"></i>কেনাকাটা চালিয়ে যান</button><button type="button" class="bf-lkpp" onclick="copyProdLink('${p.id}',this,event)" aria-label="প্রোডাক্টের লিংক কপি করুন"><i class="fa-solid fa-link"></i><span>লিংক কপি</span></button></div>
    <div class="grid md:grid-cols-2 gap-6 lg:gap-12 mt-4">
      <div class="md:sticky md:top-24 self-start">
        <div id="ppStage" class="relative overflow-hidden rounded-2xl bg-silver-100 aspect-[4/5]">
          <div id="ppTrack" class="flex h-full" style="transition:transform .5s cubic-bezier(.65,0,.35,1);transform:translateX(-${S.img*100}%)">${ppTrackHTML(p,im)}</div>
          ${p.badge?`<span class="absolute top-3 left-3 px-2.5 py-1 bg-white text-ink-900 text-[11px] font-semibold rounded-sm">${esc(badgeBn(p.badge))}</span>`:''}
          ${off?`<span class="absolute top-3 right-3 px-2.5 py-1 rounded-md btn-gold text-[11px] font-extrabold">-${off}%</span>`:''}
          <div id="ppNav">${ppNavHTML(im,S.img)}</div>
        </div>
        <div id="ppThumbs">${ppThumbsHTML(im,S.img)}</div>
      </div>
      <div>
        <div class="text-[12px] font-extrabold text-gold-600">${esc((CATEGORIES.find(c=>c.id===p.category)||{}).label||catLabel(p.category))}</div>
        <h1 class="font-lux font-bold text-xl sm:text-[1.7rem] text-ink-900 mt-1 leading-snug">${esc(p.title)}</h1>
        <div class="flex items-center gap-2 mt-2">${ppStars(p.rating)}<a href="#ppReviews" onclick="event.preventDefault();document.getElementById('ppReviews').scrollIntoView({behavior:'smooth'})" class="text-xs text-slate-500 underline" id="ppRateTxt">রিভিউ</a></div>
        <div class="mt-4 p-3.5 rounded-xl border border-amber-200/80 bg-gradient-to-br from-amber-50 via-white to-white flex items-end justify-between flex-wrap gap-x-4 gap-y-2">
          <div><div class="text-[10px] font-extrabold text-slate-500 tracking-wider">বর্তমান মূল্য</div>
            <div class="flex items-baseline flex-wrap gap-x-2.5"><span class="font-lux font-extrabold text-2xl sm:text-3xl text-ink-900 leading-none">${money(p.price)}</span>${off?`<span class="text-sm text-slate-400 line-through">${money(p.oldPrice)}</span>`:''}</div></div>
          ${off?`<div class="text-right"><span class="inline-block px-2.5 py-1 rounded-md btn-gold text-[11px] font-extrabold leading-none">${bnum(off)}% ছাড়</span><div class="text-[11px] text-emerald-600 font-bold mt-1.5">আপনি বাঁচাচ্ছেন ${money(p.oldPrice-p.price)}</div></div>`:''}
        </div>
        <div class="mt-3">${stockHTML}</div>
        <div id="ppVars">${ppVarsHTML(p)}</div>
        <div class="mt-4"><div class="text-[11px] font-extrabold mb-1.5 uppercase tracking-wider">পরিমাণ</div>
          <div class="inline-flex items-center border border-slate-200 rounded-md"><button onclick="ppQty(-1)" aria-label="Decrease" class="w-8 h-8 text-base font-bold text-slate-500 hover:text-black">−</button><span id="ppQ" class="w-9 text-center text-sm font-extrabold">1</span><button onclick="ppQty(1)" aria-label="Increase" class="w-8 h-8 text-base font-bold text-slate-500 hover:text-black">+</button></div></div>
        <div class="grid grid-cols-2 gap-2.5 mt-5">
          <button id="ppAddBtn" onclick="ppAdd(false)" ${dis} class="ppbtn w-full py-2.5 px-2 rounded-lg border border-ink-900 text-ink-900 font-bold text-[12.5px] tracking-wide hover:bg-ink-900 hover:text-white disabled:opacity-40 disabled:pointer-events-none"><i class="fa-solid fa-bag-shopping mr-1.5 text-[11px]"></i>কার্টে যোগ করুন</button>
          <button id="ppBuy" onclick="ppAdd(true)" ${dis} class="ppbtn w-full py-2.5 px-2 rounded-lg btn-gold font-bold text-[12.5px] tracking-wide shadow-md shadow-gold-500/20 disabled:opacity-40 disabled:pointer-events-none"><i class="fa-solid fa-bolt mr-1.5 text-[11px]"></i>এখনই কিনুন</button>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4 text-center">
          <div class="rounded-lg bg-slate-50 border border-slate-200 p-2"><i class="fa-solid fa-hand-holding-dollar text-gold-600 text-sm"></i><div class="text-[10px] font-bold mt-1 leading-tight">ক্যাশ অন ডেলিভারি</div></div>
          <div class="rounded-lg bg-slate-50 border border-slate-200 p-2"><i class="fa-solid fa-truck-fast text-gold-600 text-sm"></i><div class="text-[10px] font-bold mt-1 leading-tight">দ্রুত ডেলিভারি</div></div>
          <div class="rounded-lg bg-slate-50 border border-slate-200 p-2"><i class="fa-solid fa-phone-volume text-gold-600 text-sm"></i><div class="text-[10px] font-bold mt-1 leading-tight">কনফার্মেশন কল</div></div>
        </div>
        <div class="flex flex-wrap items-center gap-1.5 mt-3"><span class="text-[10px] font-bold text-slate-500 mr-1">যে পেমেন্ট নিই</span><span class="px-2 py-0.5 rounded text-[9px] font-extrabold bg-ink-900 text-white">COD</span>${pay}</div>
        <div class="text-[10.5px] text-slate-500 mt-2.5"><i class="fa-solid fa-truck-fast text-gold-500 mr-1"></i>ডেলিভারি: ঢাকার ভিতরে ${money(SHIP.dhaka)} · ঢাকার বাইরে ${money(SHIP.outside)}${FREE_SHIP<99999999?` · ${money(FREE_SHIP)} এর বেশি অর্ডারে ফ্রি`:''}</div>
        <div class="mt-5 rounded-xl bg-white border border-slate-200 overflow-hidden">
          <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center gap-2 text-[12px] font-extrabold"><span class="w-1 h-4 rounded bg-gold-500"></span>পণ্যের বিবরণ</div>
          <div class="p-4"><p id="ppDesc" class="text-[13px] text-slate-600 leading-[1.8] whitespace-pre-line break-words">${esc(p.description||'Premium quality product from BANA FASHION.')}</p>
          </div>
        </div>
      </div>
    </div>
    <section id="ppReviews" class="mt-10 pt-8 border-t border-slate-200 max-w-2xl mx-auto"></section>
    <div class="flex items-center gap-4 mt-16 mb-8"><div class="flex-1 h-px bg-slate-200"></div><h2 class="text-xs sm:text-sm font-semibold tracking-[.2em] text-ink-900">আপনার পছন্দ হতে পারে</h2><div class="flex-1 h-px bg-slate-200"></div></div>
    <div id="ppRelated" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6"></div>
  </div>`;
  // swipe on gallery
  const stg=$('ppStage'); let x0=null; stg.addEventListener('touchstart',e=>{ x0=e.touches[0].clientX; },{passive:true}); stg.addEventListener('touchend',e=>{ if(x0===null) return; const dx=e.changedTouches[0].clientX-x0; if(Math.abs(dx)>40) ppGo(dx<0?1:-1,true); x0=null; });
  const rel=[...state.products.filter(x=>x.id!==p.id&&x.category===p.category),...state.products.filter(x=>x.id!==p.id&&x.category!==p.category&&!x._rail)].slice(0,8);
  $('ppRelated').innerHTML=rel.map(ppRelCard).join(''); setTimeout(()=>$('ppRelated').querySelectorAll('.pcard').forEach(c=>pio.observe(c)),0);
  loadReviews(p.id);
}

/* ---- reviews: saved in Firebase 'reviews' collection, live updates via onSnapshot ---- */
function loadReviews(pid){
  if(state.rvUnsub){ try{state.rvUnsub();}catch(e){} state.rvUnsub=null; }
  if(!FIREBASE_READY){ drawReviews(load('bana_rev_'+pid,[])); return; }
  drawReviews(null);
  try{
    state.rvUnsub=onSnapshot(query(collection(db,'reviews'),where('pid','==',pid)),sn=>{
      if(!state.pp||state.pp.id!==pid) return;
      const r=[]; sn.forEach(d=>r.push({id:d.id,...d.data()}));
      r.sort((a,b)=>(b.at||0)-(a.at||0)); drawReviews(r);
    },err=>{ console.warn('reviews:',err.code); if(state.pp&&state.pp.id===pid) drawReviews([],true); });
  }catch(e){ drawReviews([],true); }
}
function drawReviews(list,err){
  const box=$('ppReviews'); if(!box) return;
  if(!$('rvList')){ state.pp.rv=0;
    box.innerHTML=`<div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
      <div class="px-3.5 py-2 bg-ink-900 flex items-center justify-between gap-3"><h2 class="font-display font-bold text-[12.5px] text-white flex items-center gap-2"><i class="fa-solid fa-comments text-gold-400 text-[11px]"></i>কাস্টমার রিভিউ</h2><button id="rvToggle" type="button" onclick="ppToggleForm()" class="px-2.5 py-1 rounded-md btn-gold text-[10.5px] font-bold leading-none whitespace-nowrap"><i class="fa-regular fa-comment-dots mr-1 text-[10px]"></i>রিভিউ লিখুন</button></div>
      <div class="p-3.5">
        <div id="rvSummary"></div>
        <form id="ppForm" onsubmit="ppSubmitReview(event)" class="hidden mt-3 p-3 rounded-lg bg-slate-50 border border-slate-200 space-y-2">
          <div><div class="text-[11px] font-bold mb-1">আপনার রেটিং *</div><div id="ppRateBtns" class="text-xl text-gold-500">${[1,2,3,4,5].map(i=>`<button type="button" onclick="ppRate(${i})" class="px-0.5 hover:scale-110 transition-transform" aria-label="${i} star"><i class="fa-regular fa-star"></i></button>`).join('')}</div></div>
          <input id="rvName" required maxlength="40" value="${esc(load('bana_rvname',''))}" placeholder="আপনার নাম *" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-[13px] bg-white">
          <textarea id="rvText" required rows="3" maxlength="600" placeholder="এই পণ্য সম্পর্কে আপনার অভিজ্ঞতা লিখুন *" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-[13px] bg-white"></textarea>
          <button id="rvSubmit" type="submit" class="px-5 py-2 rounded-lg btn-gold text-[11px] font-bold">রিভিউ জমা দিন</button></form>
        <div id="rvList" class="mt-2.5 divide-y divide-slate-100"></div>
      </div></div>`;
  }
  const rt=$('ppRateTxt');
  if(list===null){ $('rvSummary').innerHTML=''; $('rvList').innerHTML='<div class="py-4 text-center text-xs text-slate-400"><i class="fa-solid fa-spinner fa-spin mr-1"></i>রিভিউ লোড হচ্ছে...</div>'; if(rt) rt.textContent='রিভিউ'; return; }
  const n=list.length, avg=n?list.reduce((a,r)=>a+(+r.rating||0),0)/n:0;
  if(rt) rt.textContent=n?`${avg.toFixed(1)} (${bnum(n)} টি রিভিউ)`:'প্রথম রিভিউ দিন';
  const cnt=[5,4,3,2,1].map(k=>list.filter(r=>Math.round(+r.rating||0)===k).length);
  /* compact summary: big average on the left, slim distribution bars on the right */
  $('rvSummary').innerHTML=n?`<div class="flex items-center gap-4"><div class="text-center shrink-0 pr-4 border-r border-slate-100"><div class="font-display font-extrabold text-[1.7rem] leading-none text-ink-900">${avg.toFixed(1)}</div><div class="mt-1 text-[11px]">${ppStars(avg)}</div><div class="text-[10.5px] text-slate-500 mt-0.5">${bnum(n)} টি রিভিউ</div></div>
    <div class="flex-1 min-w-0 space-y-1">${cnt.map((c,i)=>`<div class="flex items-center gap-1.5 text-[10.5px]"><span class="w-2.5 font-bold">${5-i}</span><i class="fa-solid fa-star text-gold-500 text-[9px]"></i><div class="flex-1 h-1.5 rounded-full bg-slate-100 overflow-hidden"><div class="h-full btn-gold" style="width:${n?c/n*100:0}%"></div></div><span class="w-4 text-right text-slate-400">${c}</span></div>`).join('')}</div></div>`
    :`<p class="text-xs text-slate-500">${err?'রিভিউ এই মুহূর্তে দেখানো যাচ্ছে না, একটু পরে চেষ্টা করুন':'এখনো কোনো রিভিউ নেই — প্রথম রিভিউটি আপনিই দিন'}</p>`;
  const SHOW=3, all=!!state.pp.rvAll;
  $('rvList').innerHTML=list.map((r,idx)=>`<div class="py-2.5 flex gap-2.5 ${idx>=SHOW&&!all?'hidden':''} ${idx>=SHOW?'rv-more':''}"><div class="w-7 h-7 rounded-full bg-ink-900 text-gold-400 flex items-center justify-center font-extrabold text-[11px] shrink-0">${esc((r.name||'?').trim().charAt(0).toUpperCase())}</div><div class="min-w-0 flex-1"><div class="flex items-center gap-x-2 gap-y-0.5 flex-wrap"><b class="text-[12.5px]">${esc(r.name)}</b><span class="text-[10px]">${ppStars(r.rating)}</span><span class="ml-auto text-[10px] text-slate-400">${r.at?new Date(r.at).toLocaleDateString('en-GB'):''}</span></div><p class="text-[12px] text-slate-600 mt-0.5 leading-snug whitespace-pre-line">${esc(r.text)}</p></div></div>`).join('')
    +(n>SHOW?`<div class="pt-2.5 text-center"><button type="button" id="rvMoreBtn" data-more="সব ${bnum(n)} টি রিভিউ দেখুন <i class='fa-solid fa-chevron-down text-[9px] ml-0.5'></i>" onclick="ppRvMore()" class="text-[11.5px] font-extrabold text-gold-600 hover:text-gold-500">${all?'কম দেখুন <i class="fa-solid fa-chevron-up text-[9px] ml-0.5"></i>':'সব '+bnum(n)+' টি রিভিউ দেখুন <i class="fa-solid fa-chevron-down text-[9px] ml-0.5"></i>'}</button></div>`:'');
}
function ppDescToggle(){ const d=$('ppDesc'), b=$('ppDescBtn'); if(!d||!b) return; const open=d.classList.toggle('line-clamp-5')===false; b.innerHTML=open?'কম দেখুন <i class="fa-solid fa-chevron-up text-[9px] ml-0.5"></i>':'আরও পড়ুন <i class="fa-solid fa-chevron-down text-[9px] ml-0.5"></i>'; }
function ppRvMore(){ state.pp.rvAll=!state.pp.rvAll; document.querySelectorAll('#rvList .rv-more').forEach(e=>e.classList.toggle('hidden',!state.pp.rvAll)); const b=$('rvMoreBtn'); if(b) b.innerHTML=state.pp.rvAll?'কম দেখুন <i class="fa-solid fa-chevron-up text-[9px] ml-0.5"></i>':b.dataset.more; }
function ppToggleForm(){
  const f=$('ppForm'); if(!f) return;
  const show=f.classList.contains('hidden'); f.classList.toggle('hidden',!show);
  const b=$('rvToggle'); if(b) b.innerHTML=show?'<i class="fa-solid fa-xmark mr-1 text-[10px]"></i>বন্ধ করুন':'<i class="fa-regular fa-comment-dots mr-1 text-[10px]"></i>রিভিউ লিখুন';
  /* the form opens below the header: bring it into view so the click visibly "does something" */
  if(show) setTimeout(()=>{ try{ f.scrollIntoView({behavior:'smooth',block:'center'}); }catch(e){} },60);
}
function ppRate(i){ state.pp.rv=i; $('ppRateBtns').querySelectorAll('i').forEach((el,k)=>el.className=(k<i?'fa-solid':'fa-regular')+' fa-star'); }
async function ppSubmitReview(e){
  e.preventDefault(); if(!state.pp.rv){ toast('অনুগ্রহ করে স্টার রেটিং দিন',false); return; }
  const pid=state.pp.id, name=$('rvName').value.trim(), text=$('rvText').value.trim(); if(!name||!text) return;
  const rev={pid,name,rating:state.pp.rv,text,at:Date.now()}, btn=$('rvSubmit'); btn.disabled=true; btn.textContent='জমা হচ্ছে...';
  try{
    if(FIREBASE_READY){ await addDoc(collection(db,'reviews'),{...rev,createdAt:serverTimestamp()}); }
    else { const mine=load('bana_rev_'+pid,[]); mine.push({...rev,id:'r'+rev.at}); save('bana_rev_'+pid,mine); drawReviews(mine); }
    save('bana_rvname',name); $('rvText').value=''; state.pp.rv=0; ppRate(0); ppToggleForm(); toast('আপনার রিভিউয়ের জন্য ধন্যবাদ!');
  }catch(err){ console.warn(err); toast('রিভিউ জমা হয়নি, একটু পরে আবার চেষ্টা করুন',false); console.warn('review submit failed ['+(err.code||'')+']: Firestore rules must allow create on /reviews'); }
  btn.disabled=false; btn.textContent='রিভিউ জমা দিন';
}

/* ================= CART ================= */
function addToCart(id,qty=1,size='M',silent=false,imgOv=''){
  const p=state.products.find(x=>x.id===id); if(!p) return;
  const img=imgOv||p.image||(p.images&&p.images[0])||'';
  const ex=state.cart.find(i=>i.id===id&&i.size===size);
  if(ex){ ex.qty+=qty; if(imgOv||!ex.image) ex.image=img; } else state.cart.push({id,title:p.title,price:p.price,image:img,size,qty});
  updateCart();
  if(!silent){ showMini(ex||state.cart[state.cart.length-1]); }
}
function cartQty(i,d){ state.cart[i].qty+=d; if(state.cart[i].qty<=0) state.cart.splice(i,1); updateCart(); }
function removeItem(i){ state.cart.splice(i,1); updateCart(); }
const cartSub=()=>state.cart.reduce((a,i)=>a+i.price*i.qty,0);
const checkoutItems=()=>state.buyNow?[state.buyNow]:state.cart;      /* "Buy now" orders only that product */
const subtotal=()=>checkoutItems().reduce((a,i)=>a+i.price*i.qty,0);
function refreshBadge(bump){ const n=state.cart.reduce((a,i)=>a+i.qty,0), b=$('cartBadge'); if(!b) return; b.textContent=n>99?'99+':n; b.classList.toggle('empty',n===0); if(bump&&n>0){ b.classList.remove('bump'); void b.offsetWidth; b.classList.add('bump'); } }
let _cartSaveT=0,_cartRaf=0;
function _flushSave(){ clearTimeout(_cartSaveT); _cartSaveT=0; save('bana_cart',state.cart); }
window.addEventListener('pagehide',_flushSave); document.addEventListener('visibilitychange',()=>{ if(document.hidden) _flushSave(); });
/* badge updates instantly; the heavy parts (localStorage write, cart list rebuild) run right after the tap */
function updateCart(){
  if(!state.hold) refreshBadge(true);
  clearTimeout(_cartSaveT); _cartSaveT=setTimeout(_flushSave,350);
  if(!_cartRaf) _cartRaf=requestAnimationFrame(()=>{ _cartRaf=0; renderCartDom(); });
}
function renderCartDom(){
  $('cartList').innerHTML=state.cart.map((it,i)=>`<div class="bag-item flex gap-3 p-3 rounded-2xl bg-white/5 border border-white/10 items-center">
    <img src="${esc(CLX(it.image,240))}" class="w-16 h-20 rounded-xl object-cover shrink-0 bg-ink-800" onerror="this.style.opacity=0">
    <div class="flex-1 min-w-0"><h4 class="font-extrabold text-xs truncate text-white">${esc(it.title)}</h4><span class="inline-block mt-1 px-2 py-0.5 rounded-md bg-white/10 text-[10px] font-bold text-silver-300">সাইজ ${esc(it.size)}</span><div class="font-display text-sm text-gold-400 mt-1">${money(it.price*it.qty)}</div></div>
    <div class="flex flex-col items-end gap-2">
      <button onclick="removeItem(${i})" class="text-silver-400 hover:text-red-400 text-xs"><i class="fa-solid fa-trash"></i></button>
      <div class="flex items-center border border-white/15 rounded-lg bg-ink-800"><button onclick="cartQty(${i},-1)" class="px-2.5 py-1 text-xs font-bold hover:text-gold-400">-</button><span class="px-2 text-xs font-bold">${it.qty}</span><button onclick="cartQty(${i},1)" class="px-2.5 py-1 text-xs font-bold hover:text-gold-400">+</button></div>
    </div></div>`).join('');
  const nItems=state.cart.reduce((a,i)=>a+i.qty,0); $('cartCount').textContent=nItems+' টি পণ্য';
  const empty=state.cart.length===0;
  $('emptyCart').classList.toggle('hidden',!empty); $('emptyCart').classList.toggle('flex',empty); $('cartList').classList.toggle('hidden',empty);
  const sub=cartSub(); $('cartSubtotal').textContent=money(sub);
  const pct=Math.min(100,sub/FREE_SHIP*100); $('shipBar').style.width=pct+'%'; $('shipPct').textContent=Math.round(pct)+'%';
  $('shipText').textContent = sub>=FREE_SHIP ? '🎉 আপনি ফ্রি ডেলিভারি পেয়েছেন!' : `ফ্রি ডেলিভারির জন্য আরও ${money(FREE_SHIP-sub)} যোগ করুন`;
}
function toggleCartDrawer(){
  renderCartDom();
  const d=$('cartDrawer'),o=$('cartOverlay'),c=$('cartContent');
  if(d.classList.contains('hidden')){ d.classList.remove('hidden'); setTimeout(()=>{o.classList.remove('opacity-0');c.classList.remove('translate-x-full')},10); }
  else { o.classList.add('opacity-0'); c.classList.add('translate-x-full'); setTimeout(()=>d.classList.add('hidden'),300); }
}

/* ================= WISHLIST ================= */
function toggleWishlist(id){
  const i=state.wishlist.indexOf(id);
  if(i>-1){ state.wishlist.splice(i,1); toast('উইশলিস্ট থেকে সরানো হয়েছে'); } else { state.wishlist.push(id); toast('উইশলিস্টে যোগ হয়েছে ❤️'); }
  save('bana_wish',state.wishlist); updateWishlist(); renderProducts();
}
function updateWishlist(){
  const b=$('wishlistBadge'); b.textContent=state.wishlist.length; b.classList.toggle('opacity-0',!state.wishlist.length); b.classList.toggle('scale-0',!state.wishlist.length);
  const c=$('wishlistContent');
  if(!state.wishlist.length){ c.innerHTML='<p class="text-center text-xs text-slate-400 py-6">এখনো কোনো পছন্দের পণ্য নেই।</p>'; return; }
  c.innerHTML=state.wishlist.map(id=>state.products.find(p=>p.id===id)).filter(Boolean).map(p=>`<div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/70">
    <div class="flex items-center gap-3 min-w-0"><img src="${esc(CLX(p.image,200))}" class="w-12 h-12 rounded-xl object-cover bg-ink-800"><div class="min-w-0"><h4 class="font-extrabold text-xs truncate">${esc(p.title)}</h4><span class="text-xs font-bold text-gold-600">${money(p.price)}</span></div></div>
    <div class="flex gap-2 shrink-0"><button onclick="toggleWishlistModal();openProduct('${p.id}')" class="px-3 py-1.5 rounded-lg btn-gold font-extrabold text-xs">দেখুন</button><button onclick="toggleWishlist('${p.id}')" class="p-1.5 text-slate-400 hover:text-red-500"><i class="fa-solid fa-xmark"></i></button></div></div>`).join('');
}
function toggleWishlistModal(){ $('wishlistModal').classList.toggle('hidden'); }

/* ================= AUTH ================= */
function setUser(u){ state.user=u; }
/* No sign-in anywhere: guests order directly. A silent anonymous session is used only so Firestore rules that expect request.auth keep working. */
state.user={uid:'guest',name:'',email:''};
let authReadyRes=()=>{}; const authReady=new Promise(r=>{ authReadyRes=r; }); if(!FIREBASE_READY) authReadyRes();
if(FIREBASE_READY){ try{ signInAnonymously(auth).catch(e=>{ console.warn('Anonymous auth is off in Firebase console:',e.code); authReadyRes(); }); onAuthStateChanged(auth,u=>{ if(u){ setUser({uid:u.uid,name:'',email:''}); authReadyRes(); } }); }catch(e){ authReadyRes(); } }
function openAccount(){} function closeAuth(){} function setAuthTab(){} function submitAuth(){} function googleSignIn(){} function doSignOut(){}

/* ================= CHECKOUT ================= */
function startCheckout(){
  state.buyNow=null;
  if(!state.cart.length){ toast('আপনার ব্যাগ খালি',false); return; }
  if($('cartDrawer').classList.contains('hidden')===false) toggleCartDrawer();
  openCheckout();
}
/* ---- order summary with live + / - quantity ---- */
function renderCoItems(){
  const items=checkoutItems(), cart=!state.buyNow;
  $('coItems').innerHTML=items.map((i,k)=>`<div class="co-item"><img src="${esc(CLX(i.image,240))}" alt="" class="w-14 h-16 rounded-lg object-cover bg-ink-800 shrink-0" onerror="this.style.opacity=0">
    <div class="flex-1 min-w-0 flex flex-col justify-between"><div><div class="font-bold text-[13px] text-white truncate">${esc(i.title)}</div><div class="text-[11px] text-silver-400 mt-0.5">Size ${esc(i.size)} · ${money(i.price)}</div></div>
    <div class="flex items-center justify-between mt-1.5"><div class="co-qty"><button type="button" onclick="coQty(${k},-1)" aria-label="কমান"${i.qty<=1?' disabled style="opacity:.4"':''}>−</button><span>${i.qty}</span><button type="button" onclick="coQty(${k},1)" aria-label="বাড়ান">+</button></div><div class="font-display font-bold text-gold-400 text-sm">${money(i.price*i.qty)}</div></div></div>
    ${cart?`<button type="button" onclick="coRemove(${k})" aria-label="সরান" class="self-start text-silver-400 hover:text-red-400 text-xs p-1"><i class="fa-solid fa-trash"></i></button>`:''}</div>`).join('');
}
function coQty(k,d){
  const it=checkoutItems()[k]; if(!it) return;
  const p=state.products.find(x=>x.id===it.id), st=p?stockOf(p):null; let q=Math.max(1,it.qty+d);
  if(st!==null&&st>0&&q>st){ toast('স্টকে মাত্র '+st+' টি আছে',false); q=st; }
  if(q===it.qty) return; it.qty=q;
  if(!state.buyNow) updateCart();           /* keeps bag badge + saved cart in sync */
  renderCoItems(); updateCheckoutTotals();  /* subtotal, delivery, discount, total – all live */
}
function coRemove(k){
  if(state.buyNow) return; state.cart.splice(k,1); updateCart();
  if(!state.cart.length){ closeCheckout(); toast('আপনার ব্যাগ খালি',false); return; }
  renderCoItems(); updateCheckoutTotals();
}
/* ---- delivery area cards (inside / outside Dhaka) ---- */
function setArea(a){
  const d=$('coDist');
  if(a==='dhaka'){ if(d.value!=='Dhaka') d.value='Dhaka'; } else if(d.value==='Dhaka'){ d.value=''; }
  $('coArea').value=(a==='dhaka')?'dhaka':'outside'; onDist();
}
function renderArea(){
  const a=($('coArea')&&$('coArea').value)||'dhaka', free=subtotal()>=FREE_SHIP;
  [['dhaka','coAreaIn','coAreaInP',SHIP.dhaka],['outside','coAreaOut','coAreaOutP',SHIP.outside]].forEach(([k,id,pid,amt])=>{
    const b=$(id); if(!b) return; b.classList.toggle('on',a===k); b.setAttribute('aria-checked',a===k?'true':'false');
    $(pid).innerHTML=free?'<s>'+money(amt)+'</s>ফ্রি':money(amt); });
}
function openCheckout(){
  const items=checkoutItems(); if(!items.length){ toast('আপনার ব্যাগ খালি',false); return; }
  try{ renderCoItems(); }catch(err){ console.error('checkout items:',err); }
  /* show the form first, so a problem in the totals/payment widgets can never block it */
  $('checkoutModal').classList.remove('hidden'); $('checkoutModal').scrollTop=0; document.body.style.overflow='hidden';
  requestAnimationFrame(()=>setTimeout(()=>{ try{ initDist(); updateCheckoutTotals(); }catch(err){ console.error('checkout init:',err); } },0));   /* form is already on screen; heavy widgets fill in right after */
}
/* ---- full-page order confirmation ---- */
function showConfirm(id){
  hidePP(); closeCheckout();
  const m=$('successModal'); m.classList.remove('hidden'); m.scrollTop=0; document.body.style.overflow='hidden'; window.scrollTo(0,0);
  try{ history.replaceState({order:id},'',location.pathname+location.search+'#order-confirmed'); }catch(e){}
  document.title='অর্ডার কনফার্ম হয়েছে | '+DOC_TITLE;
}
function hideConfirm(){ const m=$('successModal'); if(!m||m.classList.contains('hidden')) return; m.classList.add('hidden'); document.body.style.overflow=''; document.title=DOC_TITLE; }
function closeConfirm(){ hideConfirm(); try{ history.replaceState(null,'',location.pathname+location.search); }catch(e){} const sh=$('shop'); if(sh) sh.scrollIntoView(); }
window.addEventListener('popstate',()=>hideConfirm());
function closeCheckout(){ $('checkoutModal').classList.add('hidden'); document.body.style.overflow=''; state.buyNow=null; }
/* ---- order-form validation: blocks submit, shows a clear pop-up, highlights + focuses the first wrong field ---- */
const BN2EN=s=>String(s||'').replace(/[০-৯]/g,d=>'০১২৩৪৫৬৭৮৯'.indexOf(d));
let _vpFocus=null;
function showValPop(items,focusId){ $('vpList').innerHTML=items.map(m=>`<li><i class="fa-solid fa-circle-xmark"></i><span>${esc(m)}</span></li>`).join(''); _vpFocus=focusId; $('valPop').classList.add('show'); setTimeout(()=>{ const b=$('valPop').querySelector('.vp-ok'); if(b) b.focus(); },30); }
function closeValPop(){ $('valPop').classList.remove('show'); const f=_vpFocus&&$(_vpFocus); if(f){ try{ f.focus({preventScroll:false}); f.scrollIntoView({block:'center',behavior:'smooth'}); }catch(e){} } }
document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&$('valPop')&&$('valPop').classList.contains('show')) closeValPop(); });
function validateOrderForm(){
  const errs=[]; ['coName','coPhone','coDist','coAddress'].forEach(id=>{ const e=$(id); if(e) e.classList.remove('bad'); });
  const bad=(id,msg)=>{ errs.push({id,msg}); const e=$(id); if(e) e.classList.add('bad'); };
  const name=$('coName').value.trim(); if(name.length<2) bad('coName','আপনার পূর্ণ নাম লিখুন');
  const ph=BN2EN($('coPhone').value).replace(/[\s-]/g,'').replace(/^\+?88/,'');
  if(!ph) bad('coPhone','মোবাইল নম্বর দিন'); else if(!/^01[3-9]\d{8}$/.test(ph)) bad('coPhone','মোবাইল নম্বর অবশ্যই ১১ ডিজিটের সঠিক নম্বর হতে হবে (যেমন 01XXXXXXXXX)');
  if(!$('coDist').value) bad('coDist','আপনার জেলা নির্বাচন করুন');
  const ad=$('coAddress').value.trim();
  if(!ad) bad('coAddress','ডেলিভারির পূর্ণাঙ্গ ঠিকানা লিখুন'); else if(ad.length<10||!/[^\d\s,.\-/]/.test(ad)) bad('coAddress','ঠিকানা অসম্পূর্ণ — বাড়ি/রোড/এলাকা/থানাসহ পূর্ণাঙ্গ ঠিকানা লিখুন');
  if(errs.length){ showValPop(errs.map(x=>x.msg),errs[0].id); return null; }
  return ph;
}
['coName','coPhone','coDist','coAddress'].forEach(id=>document.addEventListener('input',e=>{ if(e.target&&e.target.id===id) e.target.classList.remove('bad'); }));
document.addEventListener('input',e=>{ if(e.target&&e.target.id==='coPhone'){ const v=BN2EN(e.target.value); if(v!==e.target.value) e.target.value=v; } });
function shipCost(){ return subtotal()>=FREE_SHIP ? 0 : SHIP[$('coArea').value]; }
function updateCheckoutTotals(){ try{ payWatch(); }catch(e){} renderArea(); try{ renderPay(); }catch(err){ console.error('renderPay:',err); }
  { const n=checkoutItems().reduce((a,i)=>a+i.qty,0); if($('coCnt')) $('coCnt').textContent=bnum(n)+' টি পণ্য'; if($('coShipLbl')) $('coShipLbl').textContent='ডেলিভারি ('+(($('coArea').value||'dhaka')==='dhaka'?'ঢাকার ভেতরে':'ঢাকার বাইরে')+')'; } const s=subtotal(),sh=shipCost(); $('coSub').textContent=money(s); $('coShip').textContent=sh?money(sh):'ফ্রি'; if(state.promo&&s<(state.promo.minOrder||0)){ state.promo=null; $('promoMsg').textContent=''; } const dc=discAmt(); $('coDiscRow').classList.toggle('hidden',!dc); $('coDisc').textContent='-'+money(dc); if(state.promo) $('coDiscCode').textContent=state.promo.code; $('coTotal').textContent=money(s-dc+sh);
  $('noteIn').textContent=money(SHIP.dhaka); $('noteOut').textContent=money(SHIP.outside); $('noteFree').textContent=sh===0?'আপনার ডেলিভারি ফ্রি — অগ্রিম পেমেন্ট লাগবে না।':(FREE_SHIP<99999999?money(FREE_SHIP)+' এর বেশি অর্ডারে ডেলিভারি ফ্রি।':''); }
const BD={"Dhaka":"Adabor,Badda,Banani,Bangshal,Bimanbandar,Cantonment,Chawkbazar,Dakshinkhan,Darus Salam,Demra,Dhamrai,Dhanmondi,Dohar,Gendaria,Gulshan,Hazaribagh,Jatrabari,Kadamtali,Kafrul,Kalabagan,Kamrangirchar,Keraniganj,Khilgaon,Khilkhet,Kotwali,Lalbagh,Mirpur,Mohammadpur,Motijheel,Nawabganj,New Market,Pallabi,Paltan,Ramna,Rampura,Sabujbagh,Savar,Shahbagh,Shyampur,Sutrapur,Tejgaon,Turag,Uttara,Uttar Khan,Wari","Gazipur":"Gazipur Sadar,Kaliakair,Kaliganj,Kapasia,Sreepur,Tongi","Narayanganj":"Araihazar,Bandar,Narayanganj Sadar,Rupganj,Sonargaon","Narsingdi":"Belabo,Monohardi,Narsingdi Sadar,Palash,Raipura,Shibpur","Manikganj":"Daulatpur,Ghior,Harirampur,Manikganj Sadar,Saturia,Shivalaya,Singair","Munshiganj":"Gazaria,Lohajang,Munshiganj Sadar,Sirajdikhan,Sreenagar,Tongibari","Faridpur":"Alfadanga,Bhanga,Boalmari,Charbhadrasan,Faridpur Sadar,Madhukhali,Nagarkanda,Sadarpur,Saltha","Gopalganj":"Gopalganj Sadar,Kashiani,Kotalipara,Muksudpur,Tungipara","Madaripur":"Kalkini,Madaripur Sadar,Rajoir,Shibchar","Rajbari":"Baliakandi,Goalanda,Kalukhali,Pangsha,Rajbari Sadar","Shariatpur":"Bhedarganj,Damudya,Gosairhat,Naria,Shariatpur Sadar,Zajira","Tangail":"Basail,Bhuapur,Delduar,Dhanbari,Ghatail,Gopalpur,Kalihati,Madhupur,Mirzapur,Nagarpur,Sakhipur,Tangail Sadar","Kishoreganj":"Austagram,Bajitpur,Bhairab,Hossainpur,Itna,Karimganj,Katiadi,Kishoreganj Sadar,Kuliarchar,Mithamain,Nikli,Pakundia,Tarail","Chattogram":"Anwara,Banshkhali,Boalkhali,Chandanaish,Chattogram City,Fatikchhari,Hathazari,Karnaphuli,Lohagara,Mirsharai,Patiya,Rangunia,Raozan,Sandwip,Satkania,Sitakunda","Cox's Bazar":"Chakaria,Cox's Bazar Sadar,Eidgaon,Kutubdia,Maheshkhali,Pekua,Ramu,Teknaf,Ukhia","Cumilla":"Barura,Brahmanpara,Burichang,Chandina,Chauddagram,Cumilla Sadar,Cumilla Sadar Dakshin,Daudkandi,Debidwar,Homna,Laksam,Lalmai,Meghna,Monohorgonj,Muradnagar,Nangalkot,Titas","Feni":"Chhagalnaiya,Daganbhuiyan,Feni Sadar,Fulgazi,Parshuram,Sonagazi","Brahmanbaria":"Akhaura,Ashuganj,Bancharampur,Bijoynagar,Br
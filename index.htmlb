html body #mobileMenu #mobileNav a:hover,html body #mobileMenu #mobileNav a:active{background:#f4f4f4!important}
html body #mobileMenu #mobileNav a i{width:30px!important;height:30px;flex:none;border-radius:50%;background:#0a0a0a!important;color:#fff!important;display:inline-flex;align-items:center;justify-content:center;font-size:12px}
html body #mobileMenu #mobileNav a.text-gold-400{border:1.5px solid #0a0a0a}

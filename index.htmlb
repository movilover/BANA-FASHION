,Islampur,Jamalpur Sadar,Madarganj,Melandaha,Sarishabari","Netrokona":"Atpara,Barhatta,Durgapur,Kalmakanda,Kendua,Khaliajuri,Madan,Mohanganj,Netrokona Sadar,Purbadhala","Sherpur":"Jhenaigati,Nakla,Nalitabari,Sherpur Sadar,Sreebardi"};
const DIV_COUNTS=[['Dhaka',13],['Chattogram',11],['Rajshahi',8],['Khulna',10],['Barishal',6],['Sylhet',4],['Rangpur',8],['Mymensingh',4]];
const DIV_OF=(()=>{ const m={}, ks=Object.keys(BD); let n=0; DIV_COUNTS.forEach(([dv,c])=>{ ks.slice(n,n+c).forEach(d=>m[d]=dv); n+=c; }); return m; })();
function initDist(){ const el=$('coDist'); if(el.options.length<=1) el.innerHTML='<option value="">জেলা বাছাই করুন</option>'+Object.keys(BD).sort((a,b)=>(DBN[a]||a).localeCompare(DBN[b]||b,'bn')).map(d=>`<option value="${d}">${DBN[d]||d} (${d})</option>`).join(''); onDist(); }
function onDist(){
  const d=$('coDist').value, box=$('coUpBox'), up=$('coUp'), dv=DIV_OF[d]||'';
  if(d==='Dhaka') $('coArea').value='dhaka'; else if(d) $('coArea').value='outside'; $('coDiv').value=dv;
  $('coDivTxt').className='co-div'+(dv?' ok':'');
  $('coDivTxt').innerHTML=dv?`<i class="fa-solid fa-circle-check text-emerald-400"></i><span>${DVBN[dv]||dv} বিভাগ</span>`:'<i class="fa-solid fa-map text-gold-400"></i><span>জেলা বাছলে নিজে থেকে আসবে</span>';
  if(!d){ box.classList.add('hidden'); up.required=false; up.innerHTML='<option value="">উপজেলা / থানা বাছাই করুন</option>'; }
  else { up.innerHTML='<option value="">উপজেলা / থানা বাছাই করুন</option>'+BD[d].split(',').map(x=>`<option>${x}</option>`).join(''); box.classList.remove('hidden'); up.required=true; }
  const inside=(d==='Dhaka');
  $('coDelTag').innerHTML=!d?`<i class="fa-solid fa-truck-fast text-gold-400 text-lg"></i><div class="leading-relaxed"><b class="text-white">ডেলিভারি চার্জ</b><br>ঢাকার ভিতরে <b>${money(SHIP.dhaka)}</b> &nbsp;·&nbsp; ঢাকার বাইরে <b>${money(SHIP.outside)}</b></div>`
    :`<i class="fa-solid fa-truck-fast text-gold-400 text-lg"></i><div class="leading-relaxed flex-1"><b class="text-white">${inside?'ঢাকার ভিতরে':'ঢাকার বাইরে'}</b> · ${DBN[d]||d}${dv?', '+(DVBN[dv]||dv)+' বিভাগ':''}<br><span class="text-silver-400">ডেলিভারি চার্জ</span> <b class="text-white">${money(inside?SHIP.dhaka:SHIP.outside)}</b></div>`;
  updateCheckoutTotals(); }
async function placeOrder(e){
  e.preventDefault(); if(!checkoutItems().length){ toast('আপনার ব্যাগ খালি',false); return; }
  const phone=validateOrderForm(); if(!phone) return;      /* wrong/missing phone or incomplete address -> pop-up, nothing is submitted */
  let pay=null; if(state.payM&&state.payM!=='cod'&&shipCost()>0){ const sender=$('coSender').value.replace(/[\s-]/g,''), trx=$('coTrx').value.trim().toUpperCase();
    if(!/^01[3-9]\d{8}$/.test(sender)||trx.length<3||trx.length>40){ toast('আপনার সেন্ডার নম্বর ও TrxID দিন',false); return; } pay={method:state.payM,sender,trxId:trx,amount:shipCost(),status:'pending'}; }
  const btn=$('coSubmit'); btn.disabled=true; btn.innerHTML='<i class="fa-solid fa-spinner fa-spin mr-2"></i>অর্ডার হচ্ছে...';
  /* wait for the (anonymous) Firebase session so the order is written with a real uid / auth */
  if(FIREBASE_READY){ try{ await Promise.race([authReady,new Promise(r=>setTimeout(r,4000))]); if(auth&&!auth.currentUser){ try{ await Promise.race([signInAnonymously(auth),new Promise(r=>setTimeout(r,5000))]); }catch(ae){ state.authErr=ae&&ae.code||'auth-failed'; console.warn('Anonymous sign-in failed:',state.authErr); } }
    if(auth&&auth.currentUser) state.user={uid:auth.currentUser.uid,name:'',email:''}; }catch(e){} }
  const sub=subtotal(), ship=shipCost(), disc=discAmt(), orderId='BF-'+Date.now().toString(36).toUpperCase()+Array.from(crypto.getRandomValues(new Uint8Array(3)),x=>(x%36).toString(36)).join('').toUpperCase();
  const uid=(state.user&&state.user.uid)||(auth&&auth.currentUser&&auth.currentUser.uid)||('guest-'+Date.now().toString(36)+Math.random().toString(36).slice(2,8));  /* was: uid -> TypeError when anonymous sign-in was unavailable, button stayed stuck */
  const order={orderId,uid,email:(state.user&&state.user.email)||'',customerName:$('coName').value.trim(),phone,area:$('coArea').value,district:$('coDist').value,division:$('coDiv').value,upazila:$('coUp').value,address:$('coAddress').value.trim(),geo:$('coLat').value?{lat:+$('coLat').value,lng:+$('coLng').value}:null,note:$('coNote').value.trim(),
    items:checkoutItems().map(i=>({id:i.id,title:i.title,size:i.size,qty:i.qty,price:i.price})),subtotal:sub,discount:disc,promo:(disc&&state.promo)?{code:state.promo.code,type:state.promo.type,value:state.promo.value}:null,delivery:ship,total:sub-disc+ship,payment:pay?'Delivery charge via '+pay.method+' + COD':'Cash on Delivery',pay,deliveryPaid:false,courier:null,status:'pending',currency:'BDT'};
  try{
    if(FIREBASE_READY){ const build=(withTrx,ord)=>{ ord=ord||order; const bt=writeBatch(db), oref=doc(collection(db,'orders')); bt.set(oref,{...ord,createdAt:serverTimestamp()}); bt.set(doc(db,'rl',uid),{t:serverTimestamp()}); if(withTrx&&pay) bt.set(doc(db,'trx',pay.trxId),{uid:uid,orderId,at:serverTimestamp()}); bt.set(doc(db,'receipts',orderId),{orderId,uid:uid,status:'pending',total:order.total,name:(order.customerName||'').split(' ')[0],createdAt:serverTimestamp()}); if(disc&&state.promo){ bt.update(doc(db,'promos',state.promo.code),{used:increment(1)}); bt.set(doc(db,'promoUses',state.promo.code+'_'+uid),{uid:uid,orderId,at:serverTimestamp()}); } return bt; };
      /* TrxID is never checked here. 1st try: plain order. Only if an OLD rules file still demands a trx record, retry once with it (compat). */
      try{ await build(false).commit(); }catch(e1){ if(pay&&e1&&e1.code==='permission-denied'){ console.warn('order refused, retrying with trx record:',e1.message);
        try{ await build(true).commit(); }catch(e2){ if(e2&&e2.code==='permission-denied'){
          /* last resort: the order must never be lost because of the payment record. Save it with the payment details inside the note (admin panel reads them from there). */
          console.warn('order refused again, saving payment details in note:',e2.message);
          const tag=' [ADV|'+pay.method+'|'+pay.sender+'|'+pay.trxId+']'; order.pay=null; order.note=(order.note||'').slice(0,440)+tag; await build(false).commit(); } else throw e2; } }
      else throw e1; } }
    else { const all=load('bana_orders',[]); all.push({...order,createdAt:new Date().toISOString()}); save('bana_orders',all); }
    /* ---- order is saved in the database from here on ---- */
    try{
    const waNum=String((state.site&&state.site.whatsapp)||'8801353808618').replace(/\D/g,'');
    const msg=['*NEW ORDER - BANA FASHION*','অর্ডার আইডি: '+orderId,'Name: '+order.customerName,'Phone: '+phone,'Address: '+order.address+', '+order.upazila+', '+order.district+(order.division?', '+order.division+' Division':''),order.geo?'Location: https://www.google.com/maps?q='+order.geo.lat+','+order.geo.lng:'','',...order.items.map(i=>'• '+i.title+' ('+i.size+') x'+i.qty+' = '+money(i.price*i.qty)),'','Delivery: '+(ship?money(ship):'ফ্রি'),...(disc?['Promo '+state.promo.code+': -'+money(disc)]:[]),'*মোট: '+money(order.total)+'*','Payment: '+order.payment+(pay?' | TrxID: '+pay.trxId:'')].filter(x=>x!==undefined).join('\n');
    const waUrl='https://wa.me/'+waNum+'?text='+encodeURIComponent(msg); $('successWa').href=waUrl;
    if(!(state.site&&state.site.waAuto===false)) setTimeout(()=>{ try{ window.open(waUrl,'_blank'); }catch(e){} },700);
    $('successId').textContent=orderId; state.lastOrder=order; state.lastTg={items:checkoutItems().map(i=>({id:i.id,title:i.title,size:i.size,qty:i.qty,price:i.price,image:i.image||''})),stamp:tgStamp()}; waNotify(order,state.lastTg);   /* WhatsApp alert via our server (async, never blocks the order) */ try{trkSave(orderId);}catch(e){} try{myoSave(order);}catch(e){}
    $('successSummary').innerHTML=order.items.map(i=>`<div class="flex justify-between gap-2"><span class="truncate">${esc(i.title)} <span class="text-slate-400">(${esc(i.size)}) ×${i.qty}</span></span><b>${money(i.price*i.qty)}</b></div>`).join('')+`<div class="border-t border-white/10 pt-1.5 flex justify-between"><span class="text-silver-400">ডেলিভারি</span><b>${ship?money(ship):'ফ্রি'}</b></div>`+(disc?`<div class="flex justify-between"><span class="text-emerald-400">ডিসকাউন্ট</span><b>-${money(disc)}</b></div>`:'')+`<div class="flex justify-between text-sm font-extrabold"><span>মোট</span><span>${money(order.total)}</span></div><div class="border-t border-white/10 pt-1.5 text-silver-400 leading-relaxed"><b class="text-white">${esc(order.customerName)}</b> · ${esc(order.phone)}<br>${esc(order.address)}, ${esc(order.upazila)}, ${esc(DBN[order.district]||order.district)}${order.division?', '+esc(DVBN[order.division]||order.division)+' বিভাগ':''} <span class="text-gold-400 font-bold">(${order.area==='dhaka'?'ঢাকার ভিতরে':'ঢাকার বাইরে'})</span><br>পেমেন্ট: ${esc(order.payment)}</div>`;
    if(!state.buyNow) state.cart=[]; updateCart(); closeCheckout(); $('checkoutForm').reset(); onDist(); $('coLat').value=''; $('coLng').value=''; state.promo=null; $('promoMsg').textContent=''; $('geoMsg').textContent='GPS দিয়ে জেলা, এলাকা ও ঠিকানা নিজে থেকে পূরণ হবে'; showConfirm(orderId);
    }catch(uiErr){ console.error('post-order UI:',uiErr); try{ if(!state.buyNow) state.cart=[]; updateCart(); }catch(_){} try{ $('successId').textContent=orderId; }catch(_){} try{ showConfirm(orderId); }catch(_){} }
  }catch(err){ console.error(err); toast(err.code==='permission-denied'&&state.promo&&!pay?'এই প্রোমো কোডটি আর বৈধ নয়। কোডটি সরিয়ে আবার চেষ্টা করুন।':((FIREBASE_READY&&!(auth&&auth.currentUser))?'অর্ডার সেভ হয়নি: সাইটের লগইন সেশন চালু হয়নি। Firebase → Authentication → Sign-in method-এ Anonymous চালু করুন। [no-login'+(state.authErr?': '+state.authErr:'')+']':'অর্ডার সেভ হয়নি, আবার চেষ্টা করুন অথবা 01353-808618 নম্বরে কল করুন'+(err&&err.code?' ['+err.code+']':'')),false); }
  btn.disabled=false; btn.innerHTML='<i class="fa-solid fa-lock mr-2"></i>অর্ডার কনফার্ম করুন';
}

/* =====================================================================
   INVOICE IMAGE + WHATSAPP ORDER ALERT
   - the invoice card is drawn here (html2canvas) and used for the customer's PNG download and the WhatsApp alert
   - the WhatsApp message itself is built and sent by OUR SERVER from the saved order (/api/wa-notify);
     no bot token / API key ever reaches the browser. Failed sends are retried automatically.
   ===================================================================== */
/* "DD/MM/YYYY, HH:MM AM/PM" in Bangladesh time, regardless of the visitor's device timezone */
function tgStamp(d){ const p=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Dhaka',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:true}).formatToParts(d||new Date()).reduce((a,x)=>{ a[x.type]=x.value; return a; },{});
  return p.day+'/'+p.month+'/'+p.year+', '+p.hour+':'+p.minute+' '+String(p.dayPeriod||'').toUpperCase(); }
const tgPayLbl=o=>o.pay?(INV_PAY[o.pay.method]||o.pay.method):'';
/* ---- helpers for the invoice image ---- */
function tgLoadScript(src,test){ return new Promise((res,rej)=>{ if(test()) return res(); const s=document.createElement('script'); s.src=src; s.onload=()=>res(); s.onerror=()=>rej(new Error('script load failed')); document.head.appendChild(s); }); }
const tgNeedH2C=()=>tgLoadScript('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js',()=>!!window.html2canvas);
/* product photo -> small data-URL so html2canvas never hits a CORS-tainted image (empty string = use placeholder) */
function tgImg(src){ return new Promise(res=>{ if(!src) return res(''); if(/^data:/.test(src)&&src.length<200000) return res(src);
  const im=new Image(); im.crossOrigin='anonymous'; const t=setTimeout(()=>res(''),6000);
  im.onload=()=>{ clearTimeout(t); try{ const k=Math.min(1,200/Math.max(im.naturalWidth,im.naturalHeight)), c=document.createElement('canvas'); c.width=Math.max(1,Math.round(im.naturalWidth*k)); c.height=Math.max(1,Math.round(im.naturalHeight*k)); c.getContext('2d').drawImage(im,0,0,c.width,c.height); res(c.toDataURL('image/jpeg',.88)); }catch(e){ res(''); } };
  im.onerror=()=>{ clearTimeout(t); res(''); }; im.src=src; }); }
function tgQR(text){ try{ const h=document.createElement('div'); h.style.cssText='position:fixed;left:-9999px;top:0'; document.body.appendChild(h); new QRCode(h,{text,width:120,height:120,correctLevel:QRCode.CorrectLevel.M}); const cv=h.querySelector('canvas'); const u=cv?cv.toDataURL('image/png'):((h.querySelector('img')||{}).src||''); h.remove(); return u; }catch(e){ return ''; } }
/* ---- the invoice card (inline styles only, so the snapshot never depends on Tailwind) ---- */
function tgCardHTML(o,items,stamp,imgs,qr){ const pay=o.pay, due=Math.max(0,o.total-(pay?o.delivery:0)), GOLD='#ffffff', DIM='#b8b8b8', dist=(DBN[o.district]||o.district||'');
  const row=(i,n)=>`<div style="display:flex;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.16)">
    ${imgs[n]?`<img src="${imgs[n]}" style="width:60px;height:60px;border-radius:10px;object-fit:cover;border:1px solid rgba(255,255,255,.4);flex:none">`:`<div style="width:60px;height:60px;border-radius:10px;border:1px solid rgba(255,255,255,.4);background:#1a1a1a;color:${GOLD};display:flex;align-items:center;justify-content:center;font-weight:800;font-size:22px;flex:none">${esc(String(i.title||'B').charAt(0))}</div>`}
    <div style="flex:1;min-width:0"><div style="font-weight:700;font-size:14px;color:#fff;line-height:1.3">${esc(i.title)}</div><div style="font-size:12px;color:${DIM};margin-top:3px">সাইজ: ${esc(i.size)} · ${BT(i.price)} × ${BNUM(i.qty)}</div></div>
    <div style="font-weight:800;color:${GOLD};font-size:14px;white-space:nowrap">${BT(i.price*i.qty)}</div></div>`;
  const tr=(a,b,s)=>`<div style="display:flex;justify-content:space-between;padding:3px 0;${s||''}"><span style="color:${DIM}">${a}</span><span>${b}</span></div>`;
  return `<div id="tgCard" style="width:560px;box-sizing:border-box;padding:28px;background:#0a0a0a;border:2px solid #ffffff;color:#f5f5f5;font-family:'Hind Siliguri','Plus Jakarta Sans',sans-serif;font-size:13px;line-height:1.45">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
    <div><div style="font-weight:800;font-size:24px;letter-spacing:.14em;color:#fff">BANA <span style="color:${GOLD}">FASHION</span></div><div style="font-size:11px;color:${DIM};letter-spacing:.2em;margin-top:2px">ORDER INVOICE · ক্যাশ মেমো</div></div>
    <div style="text-align:right"><div style="font-size:11px;color:${DIM}">অর্ডার আইডি</div><div style="font-family:monospace;font-weight:700;font-size:16px;color:${GOLD}">${esc(o.orderId)}</div></div></div>
  <div style="margin:12px 0 4px;padding:8px 12px;border-radius:10px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.3);font-size:12.5px"><span style="color:${DIM}">আজকের তারিখ ও সময়:</span> <b style="color:#fff">${esc(stamp)}</b></div>
  <div style="margin-top:8px">${items.map(row).join('')}</div>
  <div style="margin-top:12px;padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.18)">
    ${tr('সাবটোটাল',BT(o.subtotal))}${o.discount?tr('ডিসকাউন্ট','-'+BT(o.discount),'color:#ffffff'):''}${tr('ডেলিভারি চার্জ',o.delivery?BT(o.delivery):'ফ্রি')}
    <div style="display:flex;justify-content:space-between;border-top:1px solid rgba(255,255,255,.3);margin-top:6px;padding-top:8px;font-weight:800;font-size:17px"><span>সর্বমোট</span><span style="color:${GOLD}">${BT(o.total)}</span></div>
    ${tr('ক্যাশ অন ডেলিভারিতে দেবেন',BT(due),'font-weight:700;color:#fff')}</div>
  <div style="margin-top:12px;padding:11px 14px;border-radius:12px;${pay?'background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.4)':'background:rgba(255,255,255,.05);border:1px dashed rgba(255,255,255,.4)'}">
    <div style="font-weight:800;font-size:13px;color:#ffffff">${pay?'✔ ডেলিভারি চার্জ অনলাইনে পরিশোধিত ('+esc(tgPayLbl(o))+')':(o.delivery?'✘ ডেলিভারি চার্জ অনলাইনে পরিশোধ হয়নি':'✔ ফ্রি ডেলিভারি')}</div>
    ${pay?`<div style="margin-top:4px">ট্রানজেকশন আইডি (ট্রানজেকশন আইডি): <b style="font-family:monospace;color:#fff;font-size:14px">${esc(pay.trxId)}</b></div><div style="color:${DIM};font-size:12px">সেন্ডার: ${esc(pay.sender)} · পরিমাণ: ${BT(pay.amount)}</div>`:''}</div>
  <div style="display:flex;gap:14px;align-items:stretch;margin-top:12px">
    <div style="flex:1;min-width:0;padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.18)">
      <div style="font-weight:800;color:${GOLD};font-size:12px;letter-spacing:.08em;margin-bottom:5px">কাস্টমার তথ্য</div>
      <div style="font-weight:800;font-size:15px;color:#fff">${esc(o.customerName)}</div>
      <div>📞 ${esc(o.phone)}</div><div style="margin-top:2px">📍 ${esc(o.address)}${o.upazila?', '+esc(o.upazila):''}</div>
      <div style="margin-top:2px">🏙 জেলা: <b style="color:#fff">${esc(dist)}</b>${o.division?' · '+esc(DVBN[o.division]||o.division)+' বিভাগ':''}</div></div>
    <div style="flex:none;width:136px;text-align:center;padding:8px;border-radius:12px;background:#fff">${qr?`<img src="${qr}" style="width:116px;height:116px;display:block;margin:0 auto">`:''}<div style="color:#111;font-size:10px;margin-top:2px;font-weight:600">স্ক্যান করে যাচাই করুন</div></div></div>
  <div style="margin-top:14px;text-align:center;font-size:11px;color:${DIM}">ধন্যবাদ — BANA FASHION</div></div>`; }
/* build the PNG blob for an order (null if html2canvas is unavailable) */
async function tgInvoiceBlob(o,items,stamp){ let host; try{ await tgNeedH2C(); const imgs=await Promise.all(items.map(i=>tgImg(i.image)));
    const qr=tgQR(location.origin+location.pathname+'?verify='+encodeURIComponent(o.orderId));
    host=document.createElement('div'); host.setAttribute('aria-hidden','true'); host.style.cssText='position:fixed;left:-10000px;top:0;pointer-events:none'; host.innerHTML=tgCardHTML(o,items,stamp,imgs,qr); document.body.appendChild(host);
    try{ await document.fonts.ready; }catch(e){}
    await new Promise(r=>setTimeout(r,80));          /* let the data-URL images paint */
    const el=host.firstElementChild, scale=el.offsetHeight>2400?1.4:2;
    const cv=await window.html2canvas(el,{scale,backgroundColor:'#0b0b0b',useCORS:true,logging:false});
    return await new Promise(r=>cv.toBlob(r,'image/png')); }
  catch(e){ console.warn('invoice image failed:',e); return null; }
  finally{ if(host) host.remove(); } }
/* ---- WhatsApp alert (server builds + sends the message; we only send the order id and the invoice picture) ---- */
const WA_QUEUE='bana_wa_queue';
const waDataURL=b=>new Promise(r=>{ const fr=new FileReader(); fr.onload=()=>r(fr.result); fr.onerror=()=>r(''); fr.readAsDataURL(b); });
const waQGet=()=>{ try{ return JSON.parse(localStorage.getItem(WA_QUEUE)||'[]').filter(x=>/^BF-[A-Z0-9]{4,20}$/.test(x)); }catch(e){ return []; } };
const waQSet=a=>{ try{ localStorage.setItem(WA_QUEUE,JSON.stringify(a.slice(-10))); }catch(e){} };
async function waPost(orderId,img){
  const h={'Content-Type':'application/json'};
  try{ if(window.__appCheck&&window.__getAppCheckToken){ const t=await window.__getAppCheckToken(window.__appCheck,false); if(t&&t.token) h['X-Firebase-AppCheck']=t.token; } }catch(e){}
  const r=await fetch('/api/wa-notify',{method:'POST',headers:h,body:JSON.stringify({orderId,image:img||''})});
  const j=await r.json().catch(()=>({})); if(!r.ok||j.error) throw new Error(j.error||('HTTP '+r.status)); return j; }
/* called right after an order is saved - never blocks or breaks the order flow */
async function waNotify(o,job){
  let en=null; try{ en=await (await fetch('/api/wa-enabled',{cache:'no-store'})).json(); }catch(e){}
  if(en&&!en.enabled) return;                                   /* switched off in Admin > Settings */
  let img=''; try{ const blob=await tgInvoiceBlob(o,job.items,job.stamp); if(blob) img=await waDataURL(blob); }catch(e){}
  try{ await waPost(o.orderId,img); }
  catch(e){ console.warn('WhatsApp notify failed (queued for retry):',e.message); const q=waQGet(); if(!q.includes(o.orderId)){ q.push(o.orderId); waQSet(q); } } }
let _waFlushing=false;
async function waFlush(){ if(_waFlushing||!navigator.onLine) return; const q=waQGet(); if(!q.length) return; _waFlushing=true; const left=[];
  for(const id of q){ try{ await waPost(id,''); }catch(e){ left.push(id); } } waQSet(left); _waFlushing=false; }
window.addEventListener('online',waFlush); setTimeout(waFlush,8000);
/* ---- success-page button: download the invoice card as PNG ---- */
async function tgDownloadInvoice(){ const L=state.lastTg, o=state.lastOrder, b=$('tgDlBtn'); if(!L||!o) return; const old=b.innerHTML; b.disabled=true; b.innerHTML='<i class="fa-solid fa-spinner fa-spin mr-1.5"></i>ইনভয়েস তৈরি হচ্ছে...';
  const blob=await tgInvoiceBlob(o,L.items,L.stamp); b.disabled=false; b.innerHTML=old; if(!blob){ toast('ইনভয়েস ইমেজ তৈরি করা যায়নি, আবার চেষ্টা করুন',false); return; }
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='BANA-Invoice-'+o.orderId+'.png'; document.body.appendChild(a); a.click(); setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); },1500); }
/* ---- checkout: "delivery charge paid online" checkbox (drives the existing payment-method + TrxID fields) ---- */
function onDelChk(){ const chk=$('coDelChk'), cfg=state.payCfg||{};
  if(chk.checked){ const k=['bkash','nagad','rocket','upay'].find(x=>cfg[x]&&cfg[x].number&&cfg[x].on!==false); if(!k){ chk.checked=false; toast('অনলাইন পেমেন্ট এখনো চালু নেই',false); return; } state.payM=(state.payM&&state.payM!=='cod')?state.payM:k; }
  else { if(advMandatory()){ chk.checked=true; toast('ডেলিভারি চার্জ আগে পরিশোধ করা বাধ্যতামূলক',false); return; } state.payM='cod'; }
  renderPay(); if(chk.checked){ const t=$('coTrx'); if(t) setTimeout(()=>{ try{ $('coPayInfo').scrollIntoView({block:'center',behavior:'smooth'}); }catch(e){} },60); } }
function syncDelChk(){ const chk=$('coDelChk'); if(!chk) return; const free=shipCost()===0; const man=advMandatory(); chk.checked=!free&&state.payM!=='cod'; chk.disabled=free||man; $('coDelChkWrap').classList.toggle('dis',free);
  $('coDelChkTxt').innerHTML=free?'আপনার ডেলিভারি ফ্রি — অগ্রিম পেমেন্ট লাগবে না':(man?'ডেলিভারি চার্জ অগ্রিম পরিশোধ করুন (বাধ্যতামূলক)<small>নিচে বিকাশ/নগদ বেছে টাকা পাঠিয়ে TrxID দিন</small>':'ডেলিভারি চার্জ অনলাইনে পরিশোধ করেছি<small>বিকাশ/নগদে পাঠিয়ে নিচে ট্রানজেকশন আইডি (TrxID) দিন</small>'); }

/* ================= MISC ================= */
function toggleMobileMenu(){ const m=$('mobileMenu'); m.classList.toggle('hidden'); if(!m.classList.contains('hidden')){ const n=$('mobileNav'); n.classList.remove('anim'); void n.offsetWidth; n.classList.add('anim'); } }
function setupReveal(){
  const io=new IntersectionObserver(es=>es.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } }),{threshold:.15});
  document.querySelectorAll('.reveal:not(.in)').forEach(el=>io.observe(el));
}
/* ---- stat counters: smooth 0 -> target (ease-out), replays every time the strip scrolls into view ---- */
function setupCounters(){
  const els=document.querySelectorAll('.counter'); if(!els.length) return;
  const reduce=!!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);
  const fmt=n=>Math.round(n).toLocaleString('bn-BD'), DUR=2200, ease=x=>1-Math.pow(1-x,3);
  const stop=el=>{ cancelAnimationFrame(el._raf); clearTimeout(el._wt); };
  const run=el=>{ stop(el); const to=+el.dataset.to||0;
    if(reduce){ el.textContent=fmt(to); return; }
    const go=()=>{ if(!el._in) return; const t0=performance.now();
      const tick=now=>{ const p=Math.min(1,(now-t0)/DUR); el.textContent=fmt(to*ease(p)); if(p<1) el._raf=requestAnimationFrame(tick); else el.textContent=fmt(to); };
      el._raf=requestAnimationFrame(tick); };
    const wait=()=>{ if($('preloader')) el._wt=setTimeout(wait,150); else go(); };   /* never count behind the splash screen */
    wait(); };
  els.forEach(el=>{ el.textContent=fmt(0); });
  const io=new IntersectionObserver(es=>es.forEach(en=>{ const el=en.target; el._in=en.isIntersecting;
    if(en.isIntersecting) run(el); else { stop(el); el.textContent=fmt(0); } }),{threshold:.6});
  els.forEach(el=>io.observe(el));
}
window.addEventListener('scroll',()=>{ const t=$('toTop'); const show=window.scrollY>600; t.classList.toggle('opacity-0',!show); t.classList.toggle('pointer-events-none',!show); },{passive:true});


/* ================= v2: MINI CART, BRAND LETTERS, CATEGORY LIGHTS, HELP ================= */
let miniTimer;
function showMini(it){
  flyToCart(it.image); return;
  $('miniImg').style.opacity=1; $('miniImg').src=it.image; $('miniTitle').textContent=it.title;
  $('miniMeta').textContent='Size '+it.size+' · Qty '+it.qty; $('miniPrice').textContent=money(it.price*it.qty);
  const n=state.cart.reduce((a,i)=>a+i.qty,0); $('miniCount').textContent=n+(n===1?' item':' items')+' in your bag'; $('miniSub').textContent='Subtotal '+money(subtotal());
  const m=$('miniCart'), bar=$('miniBar'); m.classList.remove('mini-out');
  bar.style.transition='none'; bar.style.width='100%'; void bar.offsetWidth; bar.style.transition='width 3.5s linear'; bar.style.width='0';
  clearTimeout(miniTimer); miniTimer=setTimeout(hideMini,3600);
}
function hideMini(){ clearTimeout(miniTimer); $('miniCart').classList.add('mini-out'); }
function toggleHelp(){ const m=$('helpMenu'); const closed=m.classList.toggle('closed'); $('helpIcon').className = closed ? 'fa-brands fa-whatsapp wa-rot' : 'fa-solid fa-xmark'; }
document.addEventListener('click',e=>{ const f=$('helpFab'); if(f && !f.contains(e.target) && !$('helpMenu').classList.contains('closed')) toggleHelp(); });

/* BANA / FASHION letters fade in & out on the first banner (loops with the slider) */
function buildShatter(){
  document.querySelectorAll('.shatter-letters').forEach(el=>{
    const w=el.dataset.w, sg=()=>Math.random()<.5?-1:1;
    el.innerHTML=[...w].map((c,i)=>{ const a=Math.random()*6.283, d=260+Math.random()*340, x=Math.cos(a)*d, y=Math.sin(a)*d*.7;   /* start far away, on a random side */
      return `<span style="--x:${x.toFixed(0)}px;--y:${y.toFixed(0)}px;--r:${(sg()*(60+Math.random()*180)).toFixed(0)}deg;--rx:${(sg()*(90+Math.random()*180)).toFixed(0)}deg;--ry:${(sg()*(180+Math.random()*360)).toFixed(0)}deg;animation-delay:${(.1+i*.07).toFixed(2)}s">${c===' '?'&nbsp;':c}</span>`; }).join('');
  });
}
function buildLetters(){
  document.querySelectorAll('.brand-letters').forEach((el,idx)=>{
    const w=el.dataset.w, base=idx?0.95:0.85;
    el.innerHTML=[...w].map((c,i)=>`<span style="animation-delay:${(base+i*.05).toFixed(2)}s">${c}</span>`).join('');
  });
}
/* categories: dark first, then lights come on one by one; re-plays each time they scroll into view */
function stopCats(){ clearTimeout(catSeqT); clearInterval(spotT); }
/* cards appear strictly in order (left -> right, top -> bottom), once; later rebuilds just show them settled */
function playCats(){
  const row=$('catRow'); if(!row) return;
  const cards=[...row.querySelectorAll('.cat-card:not(.sk)')]; if(!cards.length) return;
  if(_catsPlayed){ cards.forEach(c=>{ c.classList.remove('lit'); c.classList.add('shown'); }); return; }
  _catsPlayed=true; void row.offsetWidth;
  const step=Math.min(.14,1.6/cards.length);
  cards.forEach((c,i)=>{ c.style.setProperty('--d',(.1+i*step).toFixed(2)+'s'); c.classList.add('lit'); });
}
function setupCats(){
  const row=$('catRow'); if(!row) return;
  row.addEventListener('animationend',e=>{ const c=e.target; if(e.animationName==='cgIn'&&c.classList&&c.classList.contains('cat-card')){ c.classList.add('shown'); c.classList.remove('lit'); } });
  /* never animate behind the splash screen: start watching only once the home page is revealed */
  const start=()=>setTimeout(()=>{
    const io=new IntersectionObserver(es=>es.forEach(en=>{ if(en.intersectionRatio>=.15&&!catsInView){ catsInView=true; playCats(); } }),{threshold:[0,.15]});
    io.observe(row); },450);
  if((window.__splash||0)>=1||!$('preloader')) start(); else document.addEventListener('splash:exit',start,{once:true});
}
let _sbT=0; window.addEventListener('scroll',()=>{ if(_sbT) return; _sbT=requestAnimationFrame(()=>{ _sbT=0; const h=document.documentElement; const pct=h.scrollTop/((h.scrollHeight-h.clientHeight)||1)*100; const b=$('scrollBar'); if(b) b.style.width=pct+'%'; }); },{passive:true});


